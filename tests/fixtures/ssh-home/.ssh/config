# Keel e2e fixture (tests/onboarding.e2e.ts). scripts/e2e-serve.sh copies
# this folder to .e2e/ssh-home/.ssh, adds fresh keys, and keel serve reads
# it through KEEL_SSH_DIR: e2e never reads the real ~/.ssh.
Include config.d/*.conf

Host e2e-web e2e-api
  HostName %h.example.test
  User deploy
  IdentityFile ~/.ssh/id_e2e_plain

Host e2e-db
  HostName 10.20.0.5
  Port 2222
  User postgres
  IdentityFile ~/.ssh/id_e2e_locked

Host e2e-legacy
  HostName legacy.example.test
  User ops
  ProxyCommand ssh -W %h:%p e2e-bastion

Host *.e2e.internal web-?
  User wild

Match host e2e-web
  User nope

Host *
  ServerAliveInterval 30
