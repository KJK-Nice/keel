package ui

import "keel/components/icon"

// AgentPage is the Agent tab page (docs/ui-redesign.md §5.4.2, board
// AgentPage): three columns, the saved conversations, the conversation and
// its context (what is in scope, what was read, what was proposed). This
// is the static shell; js/ui/agentpage.js fills it from the window's one
// agent conversation, the same one the agent panel shows, with the panel's
// k-agent-* and k-prop classes.
//
// Nothing here writes to a pane: Type into <pane> on a proposal goes
// through the approve-before-type dialog and the session socket, where
// keel serve checks it with the agent service (§6).
templ AgentPage() {
	<section class="k-agentpage" id="page-agent" data-page="agent" aria-label="Agent">
		<nav class="k-agentpage-col k-agentpage-list-col" aria-label="Conversations">
			<div class="k-agentpage-list-head">
				<div class="k-agentpage-list-titlerow">
					<span class="k-agentpage-list-title">Conversations</span>
					<button type="button" class="k-btn k-btn--ghost k-btn--sm k-btn--icon" id="agentpage-new" aria-label="New conversation" title="New conversation">
						@icon.Add01()
					</button>
				</div>
				<div class="k-inputgroup">
					<span class="k-addon" aria-hidden="true">
						@icon.Search01()
					</span>
					<input class="k-input" id="agentpage-filter" type="search" placeholder="Search conversations" aria-label="Search conversations" autocomplete="off" spellcheck="false"/>
				</div>
				<div class="k-chips k-agentpage-hosts" id="agentpage-hosts" role="group" aria-label="Filter by host" hidden></div>
			</div>
			<div class="k-agentpage-list" id="agentpage-list"></div>
			<div class="k-agentpage-list-foot">
				<span class="k-help" id="agentpage-retention"></span>
				<button type="button" class="k-agentpage-link" id="agentpage-retention-settings">Retention settings</button>
			</div>
		</nav>
		<section class="k-agentpage-main" aria-label="Conversation">
			<div class="k-agentpage-head">
				<div class="k-agentpage-head-text">
					<h1 class="k-agentpage-title" id="agentpage-title">New conversation</h1>
					<form class="k-agentpage-rename" id="agentpage-rename-form" autocomplete="off" hidden>
						<input class="k-input" id="agentpage-rename-input" maxlength="120" aria-label="Conversation title" spellcheck="false"/>
						<button type="submit" class="k-btn k-btn--primary k-btn--sm">Save</button>
					</form>
					<span class="k-agent-sess-meta" id="agentpage-meta"></span>
				</div>
				<button type="button" class="k-btn k-btn--sm" id="agentpage-panel">
					Continue in panel
					<span class="k-kbd" id="agentpage-panel-kbd">⌘I</span>
				</button>
				<button type="button" class="k-btn k-btn--ghost k-btn--sm k-btn--icon" id="agentpage-rename" aria-label="Rename this conversation" title="Rename">
					@icon.PencilEdit01()
				</button>
				<button type="button" class="k-btn k-btn--ghost k-btn--sm k-btn--icon" id="agentpage-delete" aria-label="Delete this conversation" title="Delete">
					@icon.Delete02()
				</button>
			</div>
			<div class="k-agent-thread k-agentpage-thread" id="agentpage-thread" aria-live="polite"></div>
			<form class="k-agent-composer k-agentpage-composer" id="agentpage-composer" autocomplete="off">
				<textarea id="agentpage-input" rows="2" aria-label="Message the agent" placeholder="Ask about your sessions…"></textarea>
				<div class="k-agent-composer-foot">
					<span class="k-agent-hint">{ "Reads only panes in scope now · ↵ send" }</span>
					<span class="k-spacer"></span>
					<button type="button" class="k-btn k-btn--ghost k-btn--sm" id="agentpage-stop" hidden>Stop</button>
					<button type="submit" class="k-btn k-btn--primary k-btn--sm k-btn--icon" id="agentpage-send" aria-label="Send">
						@icon.ArrowUp02()
					</button>
				</div>
			</form>
		</section>
		<aside class="k-agentpage-col k-agentpage-ctx-col" aria-label="Conversation context">
			<div class="k-agentpage-ctx">
				<div class="k-agentpage-section"><span>In scope</span><span id="agentpage-scope-count">0</span></div>
				<div class="k-agentpage-ctx-rows" id="agentpage-scope"></div>
			</div>
			<div class="k-agentpage-ctx">
				<div class="k-agentpage-section"><span>Read so far</span></div>
				<div class="k-agentpage-ctx-rows" id="agentpage-reads"></div>
			</div>
			<div class="k-agentpage-ctx">
				<div class="k-agentpage-section"><span>Proposals</span><span id="agentpage-props-count">0</span></div>
				<div class="k-agentpage-ctx-rows" id="agentpage-props"></div>
			</div>
			<p class="k-help k-agentpage-ctx-note">Every read and every typed proposal is also in Logs, under Agent.</p>
		</aside>
	</section>
}
