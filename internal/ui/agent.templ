package ui

import "keel/components/icon"

// AgentPanel is the agent panel (docs/ui-redesign.md §5.4): right side,
// size-agent wide, one per window, toggled with ⌘I (Ctrl+Shift+I off
// macOS). This is the static shell; js/ui/agentpanel.js fills the scope
// picker, the thread and the composer chips, and the proposal cards use
// the same k-* classes as here.
//
// Nothing in the panel writes to a pane: a proposal's Type into pane goes
// through the approve-before-type dialog and the session socket, where
// keel serve checks it with the agent service (§6).
templ AgentPanel() {
	<aside class="k-agent" id="agent-panel" aria-label="Agent">
		<div class="k-agent-head">
			<span class="k-agent-mark" aria-hidden="true">
				@icon.AiMagic()
			</span>
			<span class="k-agent-title">Agent</span>
			<button
				type="button"
				class="k-agent-scope"
				id="agent-scope"
				aria-haspopup="dialog"
				aria-expanded="false"
				aria-controls="agent-picker"
				aria-label="Choose what the agent can read"
			>
				@icon.View()
				<span id="agent-scope-label">Reads 0 of 0 panes</span>
				@icon.ArrowDown01()
			</button>
			<span class="k-spacer"></span>
			<button type="button" class="k-btn k-btn--ghost k-btn--sm k-btn--icon" id="agent-new" aria-label="New conversation" title="New conversation">
				@icon.Add01()
			</button>
			<button type="button" class="k-btn k-btn--ghost k-btn--sm k-btn--icon" id="agent-close" aria-label="Close agent" title="Close agent">
				@icon.Cancel01()
			</button>
		</div>
		<div class="k-agent-picker" id="agent-picker" role="dialog" aria-label="Panes the agent reads" tabindex="-1" hidden></div>
		<div class="k-agent-thread" id="agent-thread" aria-live="polite"></div>
		<div class="k-agent-foot">
			@icon.Shield01()
			<span class="k-help">Nothing reaches a pane until you press Type. The agent cannot type into panes you follow, and never sees the vault.</span>
		</div>
		<form class="k-agent-composer" id="agent-composer" autocomplete="off">
			<div class="k-agent-chips" id="agent-chips"></div>
			<textarea id="agent-input" rows="2" aria-label="Message the agent" placeholder="Ask about these sessions…"></textarea>
			<div class="k-agent-composer-foot">
				<span class="k-agent-hint" id="agent-hint">{ "@ add a pane · ↵ send" }</span>
				<span class="k-spacer"></span>
				<button type="button" class="k-btn k-btn--ghost k-btn--sm" id="agent-stop" hidden>Stop</button>
				<button type="submit" class="k-btn k-btn--primary k-btn--sm k-btn--icon" id="agent-send" aria-label="Send">
					@icon.ArrowUp02()
				</button>
			</div>
		</form>
	</aside>
}

// agentToggle is the titlebar's Agent button.
templ agentToggle() {
	<button
		type="button"
		class="k-btn k-btn--ghost k-btn--sm k-agent-toggle"
		id="btn-agent"
		aria-pressed="false"
		aria-expanded="false"
		aria-controls="agent-panel"
		title="Agent"
	>
		@icon.AiMagic()
		Agent
		<span class="k-kbd" id="btn-agent-kbd">⌘I</span>
	</button>
}
