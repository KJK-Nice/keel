package ui

import (
	"keel/components"
	"keel/components/button"
	"keel/components/dialog"
	"keel/components/field"
	"keel/components/icon"
	"keel/components/input"
	"keel/components/label"
	"keel/components/toast"
	"keel/utils"
)

templ Page(p PageProps) {
	<!DOCTYPE html>
	<html
		lang="en"
		class="dark style-nova"
		data-theme="system"
		data-signals={ p.SignalsJSON() }
	>
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>Keel — SSH workspace</title>
			<script>
				(function () {
					var t = localStorage.getItem("keel-theme") || "system";
					if (t !== "light" && t !== "dark" && t !== "system") t = "system";
					document.documentElement.dataset.theme = t;
					document.documentElement.classList.toggle("dark", t === "dark" || (t === "system" && !window.matchMedia("(prefers-color-scheme: light)").matches));
					var uiSize = 12, smooth = "antialiased";
					try {
						var ui = JSON.parse(localStorage.getItem("keel-ui") || "{}");
						var n = Math.round(Number(ui.size));
						if (n >= 11 && n <= 16) uiSize = n;
						if (ui.smoothing === "subpixel" || ui.smoothing === "none") smooth = ui.smoothing;
					} catch (e) {}
					document.documentElement.style.setProperty("--ui-size", uiSize + "px");
					document.documentElement.dataset.smooth = smooth;
					var q = new URLSearchParams(location.search);
					if (q.get("chrome") === "titlebar") {
						document.documentElement.dataset.chrome = "titlebar";
						function syncFullscreen() {
							var fs = Math.round(window.innerWidth) >= screen.width - 1 && Math.round(window.innerHeight) >= screen.height - 1;
							document.documentElement.toggleAttribute("data-fullscreen", fs);
						}
						syncFullscreen();
						window.addEventListener("resize", syncFullscreen);
					}
				})();
			</script>
			<link rel="stylesheet" href="/vendor/xterm/xterm.css"/>
			<link rel="stylesheet" href="/css/output.css"/>
			<link rel="stylesheet" href="/css/keel.css"/>
			<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' fill='%23141414'/><path d='M4 25 L16 5 L28 25' fill='none' stroke='%23ececec' stroke-width='3.2' stroke-linecap='square' stroke-linejoin='miter'/></svg>"/>
			<script type="module" src="/js/datastar.js"></script>
			@components.Scripts()
		</head>
		<body class="bg-background text-foreground style-nova dark h-full overflow-hidden">
			<div class="app h-full">
				<main class="main">
					<header class="workspace-bar">
						<div class="tab-strip">
							<div class="tabs" id="tabs"></div>
							<button type="button" class="tab-new" id="btn-new-tab" data-kbd="T" title="New tab  ⌘T" aria-label="New tab">
								+
								<kbd class="kbd-hint" aria-hidden="true">T</kbd>
							</button>
						</div>
						<div class="bar-tools" id="bar-tools" hidden>
							<button type="button" class="tiny" id="btn-split-right" data-kbd="⇧D" title="Split right  ⌘⇧D">
								Split →
								<kbd class="kbd-hint" aria-hidden="true">⇧D</kbd>
							</button>
							<button type="button" class="tiny" id="btn-split-down" data-kbd="⇧E" title="Split down  ⌘⇧E">
								Split ↓
								<kbd class="kbd-hint" aria-hidden="true">⇧E</kbd>
							</button>
							<button type="button" class="tiny" id="btn-sync" title="Synchronize input">Sync</button>
						</div>
						<div class="bar-meta" id="bar-meta">
							<span id="bar-status">Vault</span>
							<div class="control-widget" id="control-widget" hidden></div>
							<button class="tiny" id="btn-share" hidden title="Copy internet join link">Share</button>
						</div>
					</header>
					<section class="stage" id="stage">
						@Vault(p)
						<div class="terminals" id="terminals" hidden></div>
					</section>
					<footer class="snippet-bar" id="active-snippets" hidden></footer>
				</main>
			</div>
			@Dialogs(p)
			@Gate(p)
			@toast.Toaster()
			<div class="toast" id="toast" hidden></div>
			<script src="/vendor/xterm/xterm.min.js"></script>
			<script src="/vendor/xterm/addon-fit.js"></script>
			<script src="/js/term.js"></script>
		</body>
	</html>
}

templ Vault(p PageProps) {
	<div class="vault is-active" id="vault">
		<nav class="vault-rail" id="vault-rail" role="tablist">
			@vaultNav("hosts", "Hosts", true) {
				@icon.Monitor(icon.Props{Class: "vault-nav-icon"})
			}
			@vaultNav("keychain", "Keychain", false) {
				@icon.KeyRound(icon.Props{Class: "vault-nav-icon"})
			}
			@vaultNav("forwards", "Port forwarding", false) {
				@icon.ArrowLeftRight(icon.Props{Class: "vault-nav-icon"})
			}
			@vaultNav("snippets", "Snippets", false) {
				@icon.CodeXml(icon.Props{Class: "vault-nav-icon"})
			}
			@vaultNav("logs", "Logs", false) {
				@icon.ScrollText(icon.Props{Class: "vault-nav-icon"})
			}
			<button
				type="button"
				class="vault-nav"
				data-vault="settings"
				data-kbd=","
				title="Settings  ⌘,"
				data-on:click="$vault = 'settings'"
				data-class:is-active="$vault === 'settings'"
			>
				@icon.Settings(icon.Props{Class: "vault-nav-icon"})
				Settings
				<kbd class="kbd-hint" aria-hidden="true">,</kbd>
			</button>
		</nav>
		<div class="vault-body">
			@HostsPage(p)
			@KeychainPage(p)
			@ForwardsPage(p)
			@SnippetsPage(p)
			@LogsPage(p)
			@SettingsPage()
		</div>
	</div>
}

templ vaultNav(id, label string, active bool) {
	<button
		type="button"
		class={ "vault-nav", templ.KV("is-active", active) }
		data-vault={ id }
		data-on:click={ "$vault = '" + id + "'" }
		data-class:is-active={ "$vault === '" + id + "'" }
	>
		{ children... }
		{ label }
	</button>
}

templ HostsPage(p PageProps) {
	<section
		class="vault-page is-active"
		id="page-hosts"
		data-page="hosts"
	>
		<div class="page-head">
			<div>
				<p class="eyebrow">This machine</p>
				<h1>Hosts</h1>
				<p class="lede">Open a local shell or SSH host. Closing a session tab detaches; the PTY stays in Live until you kill it.</p>
			</div>
		</div>
		<div class="search" data-kbd="K">
			@input.Input(input.Props{
				ID:          "search",
				Type:        "search",
				Placeholder: "Search hosts  ⌘K",
				Attributes: templ.Attributes{
					"autocomplete":                   "off",
					"data-bind":                      "query",
					"data-on:input__debounce.200ms": "@get('/ui/hosts')",
				},
			})
			<kbd class="kbd-hint" aria-hidden="true">K</kbd>
		</div>
		<h2 class="group-label">Live</h2>
		<div id="herd-list" class="host-list"></div>
		<p class="empty" id="herd-empty">No live sessions. Connect from Hosts below.</p>
		@HostList(p)
		<div class="page-actions">
			@button.Button(button.Props{
				ID:      "btn-new-host",
				Variant: button.VariantDefault,
				Size:    button.SizeSm,
				Attributes: utils.MergeAttributes(dialog.TriggerFor("host-modal"), templ.Attributes{
					"data-kbd": "N",
				}),
			}) {
				New host
				<kbd class="kbd-hint" aria-hidden="true">N</kbd>
			}
			@button.Button(button.Props{
				ID:      "btn-quick",
				Variant: button.VariantGhost,
				Size:    button.SizeSm,
				Attributes: utils.MergeAttributes(dialog.TriggerFor("quick-modal"), templ.Attributes{
					"data-kbd": "⇧O",
				}),
			}) {
				Quick connect
				<kbd class="kbd-hint" aria-hidden="true">⇧O</kbd>
			}
			@button.Button(button.Props{
				ID:      "btn-join",
				Variant: button.VariantGhost,
				Size:    button.SizeSm,
				Attributes: utils.MergeAttributes(dialog.TriggerFor("join-modal"), templ.Attributes{
					"data-kbd": "J",
				}),
			}) {
				Join session
				<kbd class="kbd-hint" aria-hidden="true">J</kbd>
			}
			@button.Button(button.Props{
				ID:      "btn-welcome-local",
				Variant: button.VariantGhost,
				Size:    button.SizeSm,
			}) {
				Open local shell
			}
		</div>
	</section>
}

templ KeychainPage(p PageProps) {
	<section class="vault-page" id="page-keychain" data-page="keychain">
		<div class="page-head">
			<div>
				<h1>Keychain</h1>
				<p class="lede">Reusable SSH identities (password or private key). This is not the OS vault wrapping key.</p>
			</div>
			@button.Button(button.Props{
				ID:         "btn-new-identity",
				Size:       button.SizeSm,
				Attributes: dialog.TriggerFor("identity-modal"),
			}) {
				New identity
			}
		</div>
		@IdentityList(p)
	</section>
}

templ ForwardsPage(p PageProps) {
	<section class="vault-page" id="page-forwards" data-page="forwards">
		<div class="page-head">
			<div>
				<h1>Port forwarding</h1>
				<p class="lede">Local, remote, and dynamic (SOCKS5) forwards. Each uses its own SSH connection.</p>
			</div>
			@button.Button(button.Props{
				ID:         "btn-new-tunnel",
				Size:       button.SizeSm,
				Attributes: dialog.TriggerFor("tunnel-modal"),
			}) {
				New forward
			}
		</div>
		@TunnelList(p)
	</section>
}

templ SnippetsPage(p PageProps) {
	<section class="vault-page" id="page-snippets" data-page="snippets">
		<div class="page-head">
			<div>
				<h1>Snippets</h1>
				<p class="lede">Saved commands. Click one to send it into the focused terminal pane.</p>
			</div>
			@button.Button(button.Props{
				ID:         "btn-new-snippet",
				Size:       button.SizeSm,
				Attributes: dialog.TriggerFor("snippet-modal"),
			}) {
				New snippet
			}
		</div>
		@SnippetList(p)
	</section>
}

templ LogsPage(p PageProps) {
	<section class="vault-page" id="page-logs" data-page="logs">
		<div class="page-head">
			<div>
				<h1>Logs</h1>
				<p class="lede">Connection and vault events. Secrets are never recorded.</p>
			</div>
			@button.Button(button.Props{
				ID:      "btn-refresh-logs",
				Variant: button.VariantGhost,
				Size:    button.SizeSm,
				Attributes: templ.Attributes{
					"data-on:click": "@get('/ui/logs')",
				},
			}) {
				Refresh
			}
		</div>
		<div class="search">
			@input.Input(input.Props{
				ID:          "log-filter",
				Type:        "search",
				Placeholder: "Filter logs",
				Attributes: templ.Attributes{
					"autocomplete":                   "off",
					"data-bind":                      "logFilter",
					"data-on:input__debounce.200ms": "@get('/ui/logs')",
				},
			})
		</div>
		@LogList(p)
	</section>
}

templ SettingsPage() {
	<section class="vault-page" id="page-settings" data-page="settings">
		<div class="page-head">
			<div>
				<h1>Settings</h1>
				<p class="lede">Appearance and terminal. Stored on this machine.</p>
			</div>
		</div>
		<form class="prefs" id="settings-form">
			<section class="pref-group">
				<h2 class="pref-heading">Appearance</h2>
				<div class="pref-row">
					<div class="pref-copy">
						<div class="pref-title">Theme</div>
						<p class="pref-desc">Light, dark, or follow the system.</p>
					</div>
					<select class="ui-select" name="theme" id="set-theme" aria-label="Color theme" data-bind="theme" data-on:change="document.documentElement.dataset.theme = $theme; localStorage.setItem('keel-theme', $theme)">
						<option value="system">System</option>
						<option value="light">Light</option>
						<option value="dark">Dark</option>
					</select>
				</div>
				<div class="pref-row">
					<div class="pref-copy">
						<div class="pref-title">UI size</div>
						<p class="pref-desc">Tabs, settings, and chrome. 11–16px. Terminal size is separate.</p>
					</div>
					<div class="ui-stepper">
						<button type="button" id="set-ui-size-dec" aria-label="Smaller UI">−</button>
						<output id="set-ui-size-out">12</output>
						<button type="button" id="set-ui-size-inc" aria-label="Larger UI">+</button>
					</div>
				</div>
				<div class="pref-row">
					<div class="pref-copy">
						<div class="pref-title">Font smoothing</div>
						<p class="pref-desc">How chrome text is drawn. Antialiased is thinner on dark UI. Terminal glyphs stay as rendered.</p>
					</div>
					<select class="ui-select" id="set-smooth" aria-label="Font smoothing">
						<option value="antialiased">Antialiased</option>
						<option value="subpixel">Subpixel</option>
						<option value="none">None</option>
					</select>
				</div>
			</section>
			<section class="pref-group">
				<h2 class="pref-heading">Terminal</h2>
				<div class="pref-row">
					<div class="pref-copy">
						<div class="pref-title">Font</div>
						<p class="pref-desc">Monospace face used in every pane.</p>
					</div>
					<select class="ui-select" name="font" id="set-font" aria-label="Terminal font">
						<option value="jetbrains">JetBrains Mono</option>
						<option value="ibmplex">IBM Plex Mono</option>
						<option value="menlo">Menlo / SF Mono</option>
						<option value="consolas">Consolas</option>
						<option value="system">System mono</option>
					</select>
				</div>
				<div class="pref-row">
					<div class="pref-copy">
						<div class="pref-title">Text size</div>
						<p class="pref-desc">10–22px. ⌘+ / ⌘− / ⌘0 also change size.</p>
					</div>
					<div class="ui-stepper" data-kbd="+">
						<button type="button" id="set-size-dec" aria-label="Smaller text">−</button>
						<output id="set-size-out">12</output>
						<button type="button" id="set-size-inc" aria-label="Larger text">+</button>
						<kbd class="kbd-hint" aria-hidden="true">+ − 0</kbd>
					</div>
				</div>
				<div class="pref-preview" aria-hidden="true">
					<pre id="term-preview">guest@keel:~ $ ssh prod-api</pre>
				</div>
				<div class="pref-row">
					<div class="pref-copy">
						<div class="pref-title">Copy on select</div>
						<p class="pref-desc">Copy terminal selection to the clipboard.</p>
					</div>
					<label class="ui-toggle">
						<input type="checkbox" id="set-copy"/>
						<span class="ui-toggle-track"></span>
					</label>
				</div>
				<div class="pref-row">
					<div class="pref-copy">
						<div class="pref-title">Right-click to paste</div>
						<p class="pref-desc">Paste clipboard into the focused pane.</p>
					</div>
					<label class="ui-toggle">
						<input type="checkbox" id="set-paste"/>
						<span class="ui-toggle-track"></span>
					</label>
				</div>
			</section>
		</form>
	</section>
}

templ Gate(p PageProps) {
	<div class="gate" id="gate" hidden?={ !p.Locked }>
		<form id="gate-form" data-on:submit="@post('/ui/vault')">
			<p class="eyebrow">Vault</p>
			if p.NeedsSetup {
				<h2 id="gate-title">Create vault</h2>
				<p class="hint" id="gate-hint">Choose a passphrase to encrypt host passwords and keys on this machine.</p>
			} else {
				<h2 id="gate-title">Unlock vault</h2>
				<p class="hint" id="gate-hint">Host passwords and keys are encrypted. Enter your vault passphrase.</p>
			}
			@field.Field() {
				@label.Label(label.Props{For: "gate-pass"}) {
					Passphrase
				}
				@input.Input(input.Props{
					ID:         "gate-pass",
					Name:       "passphrase",
					Type:       "password",
					Required:   true,
					Attributes: templ.Attributes{"autocomplete": "current-password"},
				})
			}
			<div class="modal-actions">
				@button.Button(button.Props{ID: "gate-submit", Type: button.TypeSubmit}) {
					if p.NeedsSetup {
						Create vault
					} else {
						Unlock
					}
				}
			</div>
		</form>
	</div>
}
