package ui

import (
	"keel/components"
	"keel/components/aspectratio"
	"keel/components/button"
	"keel/components/card"
	"keel/components/empty"
	"keel/components/field"
	"keel/components/icon"
	"keel/components/input"
	"keel/components/kbd"
	"keel/components/label"
	"keel/components/separator"
	"keel/components/slider"
	switchcomp "keel/components/switch"
	"keel/components/tabs"
	"keel/components/toast"
	"keel/components/tooltip"
)

templ Page(p PageProps) {
	<!DOCTYPE html>
	<html
		lang="en"
		class="dark style-nova"
		data-theme="system"
		data-signals={ p.SignalsJSON() }
	>
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>Keel — SSH workspace</title>
			<script>
				(function () {
					function applyTheme(t) {
						if (t !== "light" && t !== "dark" && t !== "system") t = "system";
						document.documentElement.dataset.theme = t;
						var dark = t === "dark" || (t === "system" && !window.matchMedia("(prefers-color-scheme: light)").matches);
						document.documentElement.classList.toggle("dark", dark);
						document.body && document.body.classList.remove("dark");
					}
					window.__keelApplyTheme = applyTheme;
					applyTheme(localStorage.getItem("keel-theme") || "system");
					var uiSize = 12, smooth = "antialiased";
					try {
						var ui = JSON.parse(localStorage.getItem("keel-ui") || "{}");
						var n = Math.round(Number(ui.size));
						if (n >= 11 && n <= 16) uiSize = n;
						if (ui.smoothing === "subpixel" || ui.smoothing === "none") smooth = ui.smoothing;
					} catch (e) {}
					document.documentElement.style.setProperty("--ui-size", uiSize + "px");
					document.documentElement.dataset.smooth = smooth;
					var q = new URLSearchParams(location.search);
					if (q.get("chrome") === "titlebar") {
						document.documentElement.dataset.chrome = "titlebar";
						function syncFullscreen() {
							var fs = Math.round(window.innerWidth) >= screen.width - 1 && Math.round(window.innerHeight) >= screen.height - 1;
							document.documentElement.toggleAttribute("data-fullscreen", fs);
						}
						syncFullscreen();
						window.addEventListener("resize", syncFullscreen);
					}
				})();
			</script>
			<link rel="stylesheet" href="/vendor/xterm/xterm.css"/>
			<link rel="stylesheet" href="/css/output.css"/>
			<link rel="stylesheet" href="/css/keel.css"/>
			<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' fill='%23141414'/><path d='M4 25 L16 5 L28 25' fill='none' stroke='%23ececec' stroke-width='3.2' stroke-linecap='square' stroke-linejoin='miter'/></svg>"/>
			<script type="module" src="/js/datastar.js"></script>
			@components.Scripts()
		</head>
		<body class="bg-background text-foreground style-nova h-full overflow-hidden">
			<div class="app h-full">
				<main class="main">
					<header class="workspace-bar">
						<div class="tab-strip">
							<div class="tabs" id="tabs"></div>
							@tooltip.Tooltip() {
								<button
									type="button"
									class="tab-new"
									id="btn-new-tab"
									data-kbd="T"
									aria-label="New tab"
									{ tooltip.Trigger(ctx)... }
								>
									+
									@hintKbd("T")
								</button>
								@tooltip.Content() {
									New tab
									@kbd.Kbd() {
										⌘T
									}
								}
							}
						</div>
						<div class="bar-tools" id="bar-tools" hidden>
							@tooltip.Tooltip() {
								@button.Button(button.Props{
									ID:      "btn-split-right",
									Variant: button.VariantGhost,
									Size:    button.SizeSm,
									Class:   "tiny",
									Attributes: mergeAttrs(tooltip.Trigger(ctx), templ.Attributes{"data-kbd": "⇧D"}),
								}) {
									Split →
									@hintKbd("⇧D")
								}
								@tooltip.Content() {
									Split right
									@kbd.Kbd() {
										⌘⇧D
									}
								}
							}
							@tooltip.Tooltip() {
								@button.Button(button.Props{
									ID:      "btn-split-down",
									Variant: button.VariantGhost,
									Size:    button.SizeSm,
									Class:   "tiny",
									Attributes: mergeAttrs(tooltip.Trigger(ctx), templ.Attributes{"data-kbd": "⇧E"}),
								}) {
									Split ↓
									@hintKbd("⇧E")
								}
								@tooltip.Content() {
									Split down
									@kbd.Kbd() {
										⌘⇧E
									}
								}
							}
							@tooltip.Tooltip() {
								@button.Button(button.Props{
									ID:         "btn-sync",
									Variant:    button.VariantGhost,
									Size:       button.SizeSm,
									Class:      "tiny",
									Attributes: tooltip.Trigger(ctx),
								}) {
									Sync
								}
								@tooltip.Content() {
									Synchronize input
								}
							}
						</div>
						<div class="bar-meta" id="bar-meta">
							<span id="bar-status">Vault</span>
							<div class="control-widget" id="control-widget" hidden></div>
							@tooltip.Tooltip() {
								@button.Button(button.Props{
									ID:      "btn-share",
									Variant: button.VariantGhost,
									Size:    button.SizeSm,
									Class:   "tiny",
									Attributes: mergeAttrs(tooltip.Trigger(ctx), templ.Attributes{"hidden": true}),
								}) {
									Share
								}
								@tooltip.Content() {
									Copy internet join link
								}
							}
						</div>
					</header>
					<section class="stage" id="stage">
						@Vault(p)
						<div class="terminals" id="terminals" hidden></div>
					</section>
					<footer class="snippet-bar" id="active-snippets" hidden></footer>
				</main>
			</div>
			@Dialogs(p)
			@Gate(p)
			@toast.Toaster()
			<script src="/vendor/xterm/xterm.min.js"></script>
			<script src="/vendor/xterm/addon-fit.js"></script>
			<script src="/js/term.js"></script>
		</body>
	</html>
}

templ Vault(p PageProps) {
	<div class="vault is-active" id="vault">
		<nav class="vault-rail" id="vault-rail" role="tablist">
			@vaultNav("hosts", "Hosts", true) {
				@icon.Monitor(icon.Props{Class: "vault-nav-icon"})
			}
			@vaultNav("keychain", "Keychain", false) {
				@icon.KeyRound(icon.Props{Class: "vault-nav-icon"})
			}
			@vaultNav("forwards", "Port forwarding", false) {
				@icon.ArrowLeftRight(icon.Props{Class: "vault-nav-icon"})
			}
			@vaultNav("snippets", "Snippets", false) {
				@icon.CodeXml(icon.Props{Class: "vault-nav-icon"})
			}
			@vaultNav("logs", "Logs", false) {
				@icon.ScrollText(icon.Props{Class: "vault-nav-icon"})
			}
			@tooltip.Tooltip() {
				<button
					type="button"
					class="vault-nav"
					data-vault="settings"
					data-kbd=","
					{ tooltip.Trigger(ctx)... }
				>
					@icon.Settings(icon.Props{Class: "vault-nav-icon"})
					Settings
					@hintKbd(",")
				</button>
				@tooltip.Content() {
					Settings
					@kbd.Kbd() {
						⌘,
					}
				}
			}
		</nav>
		<div class="vault-body">
			@HostsPage(p)
			@KeychainPage(p)
			@ForwardsPage(p)
			@SnippetsPage(p)
			@LogsPage(p)
			@SettingsPage()
		</div>
	</div>
}

templ vaultNav(id, label string, active bool) {
	<button
		type="button"
		class={ "vault-nav", templ.KV("is-active", active) }
		data-vault={ id }
	>
		{ children... }
		{ label }
	</button>
}

templ HostsPage(p PageProps) {
	<section
		class="vault-page is-active"
		id="page-hosts"
		data-page="hosts"
	>
		<div class="page-head">
			<div>
				<p class="eyebrow">This machine</p>
				<h1>Hosts</h1>
				<p class="lede">Open a local shell or SSH host. Closing a session tab detaches; the PTY stays in Live until you kill it.</p>
			</div>
		</div>
		<div class="search" data-kbd="K">
			@input.Input(input.Props{
				ID:          "search",
				Type:        "search",
				Placeholder: "Search hosts  ⌘K",
				Attributes: templ.Attributes{
					"aria-label":                     "Search hosts",
					"autocomplete":                   "off",
					"data-bind":                      "query",
					"data-on:input__debounce.200ms": "@get('/ui/hosts')",
				},
			})
			@hintKbd("K")
		</div>
		<h2 class="group-label">Live</h2>
		<div id="herd-list" class="host-list"></div>
		@empty.Empty(empty.Props{ID: "herd-empty"}) {
			@empty.Header() {
				@empty.Title() {
					No live sessions
				}
				@empty.Description() {
					Connect from Hosts below.
				}
			}
		}
		@HostList(p)
		<div class="page-actions">
			@button.Button(button.Props{
				ID:         "btn-new-host",
				Variant:    button.VariantDefault,
				Size:       button.SizeSm,
				Attributes: templ.Attributes{"data-kbd": "N"},
			}) {
				New host
				@hintKbd("N")
			}
			@button.Button(button.Props{
				ID:         "btn-quick",
				Variant:    button.VariantGhost,
				Size:       button.SizeSm,
				Attributes: templ.Attributes{"data-kbd": "⇧O"},
			}) {
				Quick connect
				@hintKbd("⇧O")
			}
			@button.Button(button.Props{
				ID:         "btn-join",
				Variant:    button.VariantGhost,
				Size:       button.SizeSm,
				Attributes: templ.Attributes{"data-kbd": "J"},
			}) {
				Join session
				@hintKbd("J")
			}
			@button.Button(button.Props{
				ID:      "btn-welcome-local",
				Variant: button.VariantGhost,
				Size:    button.SizeSm,
			}) {
				Open local shell
			}
		</div>
	</section>
}

templ KeychainPage(p PageProps) {
	<section class="vault-page" id="page-keychain" data-page="keychain">
		<div class="page-head">
			<div>
				<h1>Keychain</h1>
				<p class="lede">Reusable SSH identities (password or private key). This is not the OS vault wrapping key.</p>
			</div>
			@button.Button(button.Props{
				ID:   "btn-new-identity",
				Size: button.SizeSm,
			}) {
				New identity
			}
		</div>
		@IdentityList(p)
	</section>
}

templ ForwardsPage(p PageProps) {
	<section class="vault-page" id="page-forwards" data-page="forwards">
		<div class="page-head">
			<div>
				<h1>Port forwarding</h1>
				<p class="lede">Local, remote, and dynamic (SOCKS5) forwards. Each uses its own SSH connection.</p>
			</div>
			@button.Button(button.Props{
				ID:   "btn-new-tunnel",
				Size: button.SizeSm,
			}) {
				New forward
			}
		</div>
		@TunnelList(p)
	</section>
}

templ SnippetsPage(p PageProps) {
	<section class="vault-page" id="page-snippets" data-page="snippets">
		<div class="page-head">
			<div>
				<h1>Snippets</h1>
				<p class="lede">Saved commands. Click one to send it into the focused terminal pane.</p>
			</div>
			@button.Button(button.Props{
				ID:   "btn-new-snippet",
				Size: button.SizeSm,
			}) {
				New snippet
			}
		</div>
		@SnippetList(p)
	</section>
}

templ LogsPage(p PageProps) {
	<section class="vault-page" id="page-logs" data-page="logs">
		<div class="page-head">
			<div>
				<h1>Logs</h1>
				<p class="lede">Connection and vault events. Secrets are never recorded.</p>
			</div>
			@button.Button(button.Props{
				ID:      "btn-refresh-logs",
				Variant: button.VariantGhost,
				Size:    button.SizeSm,
				Attributes: templ.Attributes{
					"data-on:click": "@get('/ui/logs')",
				},
			}) {
				Refresh
			}
		</div>
		<div class="search">
			@input.Input(input.Props{
				ID:          "log-filter",
				Type:        "search",
				Placeholder: "Filter logs",
				Attributes: templ.Attributes{
					"aria-label":                     "Filter logs",
					"autocomplete":                   "off",
					"data-bind":                      "logFilter",
					"data-on:input__debounce.200ms": "@get('/ui/logs')",
				},
			})
		</div>
		@LogList(p)
	</section>
}

templ SettingsPage() {
	<section class="vault-page" id="page-settings" data-page="settings">
		<div class="page-head">
			<div>
				<h1>Settings</h1>
				<p class="lede">Appearance and terminal. Stored on this machine.</p>
			</div>
		</div>
		<form class="prefs" id="settings-form">
			@tabs.Tabs(tabs.Props{ID: "settings-tabs", DefaultValue: "appearance", Class: "w-full"}) {
				@tabs.List(tabs.ListProps{Variant: tabs.VariantLine}) {
					@tabs.Trigger(tabs.TriggerProps{Value: "appearance"}) {
						Appearance
					}
					@tabs.Trigger(tabs.TriggerProps{Value: "terminal"}) {
						Terminal
					}
				}
				@tabs.Content(tabs.ContentProps{Value: "appearance", Class: "pt-3"}) {
					@card.Card(card.Props{Size: card.SizeSm}) {
						@card.Header() {
							@card.Title() {
								Appearance
							}
							@card.Description() {
								Theme, chrome size, and how UI text is drawn.
							}
						}
						@card.Content(card.ContentProps{Class: "flex flex-col gap-0"}) {
							<div class="pref-row">
								<div class="pref-copy">
									<div class="pref-title">Theme</div>
									<p class="pref-desc">Light, dark, or follow the system.</p>
								</div>
								@settingsSelect("set-theme", "theme", "Color theme", "Theme", "system", []string{"system", "light", "dark"}, []string{"System", "Light", "Dark"})
							</div>
							@separator.Separator(separator.Props{Class: "my-1"})
							<div class="pref-row">
								<div class="pref-copy">
									<div class="pref-title">UI size</div>
									<p class="pref-desc">Tabs, settings, and chrome. 11–16px. Terminal size is separate.</p>
								</div>
								<div class="pref-slider">
									@slider.Slider(slider.Props{
										ID:           "set-ui-size",
										Min:          11,
										Max:          16,
										Step:         1,
										DefaultValue: []float64{12},
										Class:        "w-36",
									})
									<output id="set-ui-size-out">12</output>
								</div>
							</div>
							@separator.Separator(separator.Props{Class: "my-1"})
							<div class="pref-row">
								<div class="pref-copy">
									<div class="pref-title">Font smoothing</div>
									<p class="pref-desc">How chrome text is drawn. Antialiased is thinner on dark UI. Terminal glyphs stay as rendered.</p>
								</div>
								@settingsSelect("set-smooth", "smoothing", "Font smoothing", "Smoothing", "antialiased", []string{"antialiased", "subpixel", "none"}, []string{"Antialiased", "Subpixel", "None"})
							</div>
						}
					}
				}
				@tabs.Content(tabs.ContentProps{Value: "terminal", Class: "pt-3"}) {
					@card.Card(card.Props{Size: card.SizeSm}) {
						@card.Header() {
							@card.Title() {
								Terminal
							}
							@card.Description() {
								Font, size, and copy/paste for every pane.
							}
						}
						@card.Content(card.ContentProps{Class: "flex flex-col gap-0"}) {
							<div class="pref-row">
								<div class="pref-copy">
									<div class="pref-title">Font</div>
									<p class="pref-desc">Monospace face used in every pane.</p>
								</div>
								@settingsSelect("set-font", "font", "Terminal font", "Font", "jetbrains", []string{"jetbrains", "ibmplex", "menlo", "consolas", "system"}, []string{"JetBrains Mono", "IBM Plex Mono", "Menlo / SF Mono", "Consolas", "System mono"})
							</div>
							@separator.Separator(separator.Props{Class: "my-1"})
							<div class="pref-row">
								<div class="pref-copy">
									<div class="pref-title">Text size</div>
									<p class="pref-desc">10–22px. ⌘+ / ⌘− / ⌘0 also change size.</p>
								</div>
								<div class="pref-slider" data-kbd="+">
									@slider.Slider(slider.Props{
										ID:           "set-size",
										Min:          10,
										Max:          22,
										Step:         1,
										DefaultValue: []float64{12},
										Class:        "w-36",
									})
									<output id="set-size-out">12</output>
									@hintKbd("+ − 0")
								</div>
							</div>
							@aspectratio.AspectRatio(aspectratio.Props{Ratio: "16/5", Class: "pref-preview mt-2 overflow-hidden"}) {
								<pre id="term-preview" class="absolute inset-0 m-0 flex items-center px-3">guest@keel:~ $ ssh prod-api</pre>
							}
							@separator.Separator(separator.Props{Class: "my-1"})
							<div class="pref-row">
								<div class="pref-copy">
									<div class="pref-title">Copy on select</div>
									<p class="pref-desc">Copy terminal selection to the clipboard.</p>
								</div>
								@switchcomp.Switch(switchcomp.Props{ID: "set-copy"})
							</div>
							<div class="pref-row">
								<div class="pref-copy">
									<div class="pref-title">Right-click to paste</div>
									<p class="pref-desc">Paste clipboard into the focused pane.</p>
								</div>
								@switchcomp.Switch(switchcomp.Props{ID: "set-paste"})
							</div>
						}
					}
				}
			}
		</form>
	</section>
}

templ Gate(p PageProps) {
	<div class="gate" id="gate" hidden?={ !p.Locked }>
		@card.Card(card.Props{Class: "gate-card w-[min(22rem,100%)]"}) {
			<form id="gate-form">
				@card.Header() {
					<p class="eyebrow">Vault</p>
					if p.NeedsSetup {
						@card.Title(card.TitleProps{ID: "gate-title"}) {
							Create vault
						}
						@card.Description(card.DescriptionProps{ID: "gate-hint"}) {
							Choose a passphrase to encrypt host passwords and keys on this machine.
						}
					} else {
						@card.Title(card.TitleProps{ID: "gate-title"}) {
							Unlock vault
						}
						@card.Description(card.DescriptionProps{ID: "gate-hint"}) {
							Host passwords and keys are encrypted. Enter your vault passphrase.
						}
					}
				}
				@card.Content() {
					@field.Field() {
						@label.Label(label.Props{For: "gate-pass"}) {
							Passphrase
						}
						@input.Input(input.Props{
							ID:         "gate-pass",
							Name:       "passphrase",
							Type:       "password",
							Required:   true,
							Attributes: templ.Attributes{"autocomplete": "current-password"},
						})
					}
				}
				@card.Footer() {
					@button.Button(button.Props{ID: "gate-submit", Type: button.TypeSubmit}) {
						if p.NeedsSetup {
							Create vault
						} else {
							Unlock
						}
					}
				}
			</form>
		}
	</div>
}
