package ui

import (
	"keel/components"
	"keel/components/button"
	"keel/components/card"
	"keel/components/field"
	"keel/components/icon"
	"keel/components/input"
	"keel/components/kbd"
	"keel/components/label"
	"keel/components/toast"
	"keel/components/tooltip"
)

templ Page(p PageProps) {
	<!DOCTYPE html>
	<html
		lang="en"
		class="dark style-nova"
		data-theme="dark"
		data-theme-choice="system"
		data-sidebar="open"
		data-signals={ p.SignalsJSON() }
		if p.Native {
			data-native="1"
		}
	>
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>Keel — SSH workspace</title>
			<script>
				(function () {
					function applyTheme(t) {
						if (t !== "light" && t !== "dark" && t !== "system") t = "system";
						var dark = t === "dark" || (t === "system" && !window.matchMedia("(prefers-color-scheme: light)").matches);
						// CSS sees only the resolved theme; the choice is kept beside it.
						document.documentElement.dataset.themeChoice = t;
						document.documentElement.dataset.theme = dark ? "dark" : "light";
						document.documentElement.classList.toggle("dark", dark);
						document.documentElement.style.colorScheme = dark ? "dark" : "light";
						document.body && document.body.classList.remove("dark");
					}
					window.__keelApplyTheme = applyTheme;
					applyTheme(localStorage.getItem("keel-theme") || "system");
					var uiSize = 12, smooth = "antialiased", sidebar = "open";
					try {
						var ui = JSON.parse(localStorage.getItem("keel-ui") || "{}");
						var n = Math.round(Number(ui.size));
						if (n >= 11 && n <= 16) uiSize = n;
						if (ui.smoothing === "subpixel" || ui.smoothing === "none") smooth = ui.smoothing;
						if (ui.vaultSidebar === false) sidebar = "closed";
					} catch (e) {}
					document.documentElement.style.setProperty("--ui-size", uiSize + "px");
					document.documentElement.dataset.smooth = smooth;
					document.documentElement.dataset.sidebar = sidebar;
					var q = new URLSearchParams(location.search);
					if (q.get("native") === "1") document.documentElement.dataset.native = "1";
					if (q.get("chrome") === "titlebar") {
						document.documentElement.dataset.chrome = "titlebar";
						function syncFullscreen() {
							var fs = Math.round(window.innerWidth) >= screen.width - 1 && Math.round(window.innerHeight) >= screen.height - 1;
							document.documentElement.toggleAttribute("data-fullscreen", fs);
						}
						syncFullscreen();
						window.addEventListener("resize", syncFullscreen);
					}
				})();
			</script>
			<link rel="stylesheet" href="/vendor/xterm/xterm.css"/>
			<link rel="stylesheet" href="/vendor/notebook/prosemirror.css"/>
			<link rel="stylesheet" href="/fonts/fonts.css"/>
			<link rel="stylesheet" href="/css/tokens.css"/>
			<link rel="stylesheet" href="/css/output.css"/>
			<link rel="stylesheet" href="/css/keel.css"/>
			<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='7.2' fill='%23ffffff'/><path fill='%23141414' transform='translate(4,5.5) scale(0.24)' d='m90.3 25.8-37.6-21.8c-1.5-0.9-3.3-1-4.9-0.2l-33.2 18.9c-1.5 0.8-1.5 3 0 3.8l36.6 21.4c1.7 0.9 1.7 3.3 0 4.2-0.7 0.5-1.6 0.4-2.4 0l-36.8-21.7c-1.5-0.9-3.2 0.2-3.2 1.8v40.1c0 1 0.6 2.1 1.5 2.7l38.1 21.4c1 0.6 2.2 0.7 3.2 0.1l38.6-21.4c0.9-0.6 1.3-1.6 1.3-2.7v-44.5c-0.1-0.8-0.4-1.5-1.2-2.1z'/></svg>"/>
			<script type="module" src="/js/datastar.js"></script>
			@components.Scripts()
		</head>
		<body class="bg-background text-foreground style-nova h-full overflow-hidden">
			<div class="app h-full">
				<main class="main">
					<header class="workspace-bar">
						@tooltip.Tooltip() {
							<button
								type="button"
								class="k-btn k-btn--ghost k-btn--sm k-btn--icon sidebar-toggle"
								id="btn-sidebar"
								data-kbd="B"
								aria-label="Toggle vault sidebar"
								aria-pressed="true"
								aria-expanded="true"
								aria-controls="vault-sidebar"
								{ tooltip.Trigger(ctx)... }
							>
								@icon.PanelLeft()
								@hintKbd("B")
							</button>
							@tooltip.Content() {
								Vault sidebar
								@kbd.Kbd() {
									⌘B
								}
							}
						}
						<div class="tab-strip">
							@tabContextMenu()
							@tooltip.Tooltip() {
								<button
									type="button"
									class="tab-new"
									id="btn-new-tab"
									data-kbd="T"
									aria-label="New tab"
									{ tooltip.Trigger(ctx)... }
								>
									<span class="k-i" aria-hidden="true">
										<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5V19"></path><path d="M19 12H5"></path></svg>
									</span>
									@hintKbd("T")
								</button>
								@tooltip.Content() {
									New tab
									@kbd.Kbd() {
										⌘T
									}
								}
							}
						</div>
						<div class="bar-meta" id="bar-meta">
							<span id="bar-status"></span>
							<div class="control-widget" id="control-widget" hidden></div>
							@tooltip.Tooltip() {
								@button.Button(button.Props{
									ID:      "btn-share",
									Variant: button.VariantGhost,
									Size:    button.SizeSm,
									Class:   "tiny",
									Attributes: mergeAttrs(tooltip.Trigger(ctx), templ.Attributes{"hidden": true}),
								}) {
									Share
								}
								@tooltip.Content() {
									Copy internet join link
								}
							}
						</div>
					</header>
					<div class="workspace">
						@VaultSidebar(p)
						<section class="stage" id="stage">
							<div class="terminals" id="terminals"></div>
							@Pages(p)
						</section>
					</div>
					@statusBar()
				</main>
			</div>
			@Dialogs(p)
			@Gate(p)
			@toast.Toaster()
			<script src="/vendor/xterm/xterm.min.js"></script>
			<script src="/vendor/xterm/addon-fit.js"></script>
			<script src="/vendor/xterm/addon-webgl.js"></script>
			<script src="/vendor/xterm/addon-unicode-graphemes.js"></script>
			<script src="/vendor/xterm/addon-web-links.js"></script>
			<script src="/vendor/xterm/addon-search.js"></script>
			<script src="/vendor/xterm/addon-progress.js"></script>
			<script src="/vendor/notebook/editor.js"></script>
			<script type="module" src="/js/term.js"></script>
		</body>
	</html>
}

templ Gate(p PageProps) {
	<div class="gate" id="gate" hidden?={ !p.Locked }>
		@card.Card(card.Props{Class: "gate-card w-[min(22rem,100%)]"}) {
			<form id="gate-form">
				@card.Header() {
					<p class="eyebrow">Vault</p>
					if p.NeedsSetup {
						@card.Title(card.TitleProps{ID: "gate-title"}) {
							Create vault
						}
						@card.Description(card.DescriptionProps{ID: "gate-hint"}) {
							Choose a passphrase to encrypt host passwords and keys on this machine.
						}
					} else {
						@card.Title(card.TitleProps{ID: "gate-title"}) {
							Unlock vault
						}
						@card.Description(card.DescriptionProps{ID: "gate-hint"}) {
							Host passwords and keys are encrypted. Enter your vault passphrase.
						}
					}
				}
				@card.Content() {
					@field.Field() {
						@label.Label(label.Props{For: "gate-pass"}) {
							Passphrase
						}
						@input.Input(input.Props{
							ID:         "gate-pass",
							Name:       "passphrase",
							Type:       "password",
							Required:   true,
							Attributes: templ.Attributes{"autocomplete": "current-password"},
						})
					}
				}
				@card.Footer() {
					@button.Button(button.Props{ID: "gate-submit", Type: button.TypeSubmit}) {
						if p.NeedsSetup {
							Create vault
						} else {
							Unlock
						}
					}
				}
			</form>
		}
	</div>
}

// statusBar is the 24px strip at the bottom of the window. term.js fills it
// (renderStatusBar): runtime and session count, running forwards, the focused
// pane's name and size, encoding, and input sync.
templ statusBar() {
	<footer class="k-status" id="status-bar" aria-label="Status">
		<span id="sb-runtime"><span class="k-dot k-dot--live" aria-hidden="true"></span><span id="sb-runtime-text">keel serve</span></span>
		<span id="sb-forwards" hidden>
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 17L4 17"></path><path d="M17 14C17 14 20 16.2 20 17C20 17.8 17 20 17 20"></path><path d="M5 7L20 7"></path><path d="M7 4C7 4 4 6.2 4 7C4 7.8 7 10 7 10"></path></svg>
			<span id="sb-forwards-text"></span>
		</span>
		<span class="k-status-gap"></span>
		<span id="sb-pane" hidden></span>
		<span id="sb-sync" hidden>Sync off</span>
	</footer>
}
