package ui

// The Settings sections beyond Appearance, Terminal and Agent
// (docs/ui-redesign.md §5.9, the board's section list). Each shows only what
// Keel can do today: Keyboard, Vault & security and About are read-only;
// Sharing has one editable value; Runtime has Stop. The values are filled by
// js/ui/settingspages.js.

// keyboardSettingsPanel is Settings · Keyboard. The groups come from
// lib/shortcutmap.js, the table the command palette's key hints use, so the
// two cannot drift.
templ keyboardSettingsPanel() {
	<div class="settings-panel" id="settings-keyboard" data-settings-panel="keyboard" role="tabpanel" hidden>
		<h1 class="k-page-title">Keyboard</h1>
		<p class="k-muted k-settings-lead">The keys Keel handles. They are fixed; the command palette shows the same keys beside each action.</p>
		<div class="k-settings-groups" id="kbd-groups"></div>
	</div>
}

// sharingSettingsPanel is Settings · Sharing. The display name is the one
// editable value (kept in this browser's storage; the desktop app passes
// KEEL_NAME as the default). The signal server is keel serve's KEEL_SIGNAL.
// The two access rows describe rules the share code enforces.
templ sharingSettingsPanel() {
	<div class="settings-panel" id="settings-sharing" data-settings-panel="sharing" role="tabpanel" hidden>
		<h1 class="k-page-title">Sharing</h1>
		<p class="k-muted k-settings-lead">Share a session by link. Nobody joins without your say, and the keyboard stays with you until you pass it.</p>
		@settingsGroup("You") {
			<div class="pref-row">
				<div class="pref-copy">
					<label class="pref-title" for="share-set-name">Display name</label>
					<p class="pref-desc" id="share-set-name-help">Shown to people in sessions you share and join. Empty uses the default.</p>
				</div>
				<input autocapitalize="off" autocorrect="off" id="share-set-name" class="k-input k-pref-input" type="text" maxlength="40" autocomplete="off" spellcheck="false" aria-describedby="share-set-name-help"/>
			</div>
		}
		@settingsGroup("Signal server") {
			<div class="pref-row">
				<div class="pref-copy">
					<div class="pref-title">Server for internet join links</div>
					<p class="pref-desc" id="share-set-signal-help"></p>
				</div>
				<span class="k-mono k-pref-value" id="share-set-signal"></span>
			</div>
		}
		@settingsGroup("Access") {
			<div class="pref-row">
				<div class="pref-copy">
					<div class="pref-title">Joining needs your approval</div>
					<p class="pref-desc">Anyone with the link can ask to watch. You see the name they typed and choose Allow or Deny.</p>
				</div>
				@alwaysOn()
			</div>
			<div class="pref-row">
				<div class="pref-copy">
					<div class="pref-title">Control stays with you</div>
					<p class="pref-desc">Viewers can ask for control. You pass it to one person and can take it back.</p>
				</div>
				@alwaysOn()
			</div>
		}
	</div>
}

// vaultSettingsPanel is Settings · Vault & security: read-only, filled from
// GET /api/vault, which holds no secret.
templ vaultSettingsPanel() {
	<div class="settings-panel" id="settings-vault" data-settings-panel="vault" role="tabpanel" hidden>
		<h1 class="k-page-title">Vault &amp; security</h1>
		<p class="k-muted k-settings-lead">Passwords, key passphrases and the agent key are encrypted in the vault file. Nothing here shows a secret.</p>
		@settingsGroup("Vault") {
			<div class="pref-row">
				<div class="pref-copy">
					<div class="pref-title">State</div>
				</div>
				<span class="k-badge k-badge--outline" id="vault-set-state"></span>
			</div>
			<div class="pref-row">
				<div class="pref-copy">
					<div class="pref-title">Unlocked with</div>
					<p class="pref-desc" id="vault-set-mode-help"></p>
				</div>
				<span class="k-badge k-badge--outline" id="vault-set-mode"></span>
			</div>
			<div class="pref-row">
				<div class="pref-copy">
					<div class="pref-title">Vault file</div>
					<p class="pref-desc k-mono k-wrap" id="vault-set-path"></p>
				</div>
				<button type="button" class="k-btn k-btn--sm" data-copy-from="vault-set-path">Copy path</button>
			</div>
		}
		@settingsGroup("Safety") {
			<div class="pref-row">
				<div class="pref-copy">
					<div class="pref-title">The agent never sees vault contents</div>
					<p class="pref-desc">Passwords, keys and passphrases are never sent to a model. Every agent read and insert is in Logs.</p>
				</div>
				@alwaysOn()
			</div>
			<div class="pref-row">
				<div class="pref-copy">
					<div class="pref-title">A lost passphrase cannot be recovered</div>
					<p class="pref-desc">Keel never re-keys or overwrites an existing vault from the unlock screen.</p>
				</div>
			</div>
		}
	</div>
}

// runtimeSettingsPanel is Settings · Runtime: keel serve's status from GET
// /api/runtime, and Stop, which ends every session (behind the alertdialog).
templ runtimeSettingsPanel() {
	<div class="settings-panel" id="settings-runtime" data-settings-panel="runtime" role="tabpanel" hidden>
		<h1 class="k-page-title">Runtime</h1>
		<p class="k-muted k-settings-lead">keel serve owns your sessions and serves this window. It keeps running when the window closes.</p>
		@settingsGroup("Status") {
			@statRow("Build", "run-set-build")
			@statRow("Address", "run-set-addr")
			@statRow("Data folder", "run-set-data")
			@statRow("Process id", "run-set-pid")
			@statRow("Running sessions", "run-set-sessions")
			@statRow("Uptime", "run-set-uptime")
		}
		@settingsGroup("Window") {
			<div class="pref-row">
				<div class="pref-copy">
					<div class="pref-title">Sessions keep running after the window closes</div>
					<p class="pref-desc">Closing the window detaches; reopen Keel to attach. Closing a session tab ends that session.</p>
				</div>
				@alwaysOn()
			</div>
		}
		@settingsGroup("Stop") {
			<div class="pref-row">
				<div class="pref-copy">
					<div class="pref-title">Stop the Keel runtime</div>
					<p class="pref-desc">Ends every running session and port forward, then closes keel serve. Reopen Keel to start it again.</p>
				</div>
				<button type="button" class="k-btn k-btn--danger k-btn--sm" id="run-set-stop">Stop runtime…</button>
			</div>
		}
	</div>
}

// aboutSettingsPanel is About Keel, opened from the footer of the section
// list. Keel has no release number yet, so the version is the build's
// revision.
templ aboutSettingsPanel() {
	<div class="settings-panel" id="settings-about" data-settings-panel="about" role="tabpanel" hidden>
		<h1 class="k-page-title">About Keel</h1>
		<p class="k-muted k-settings-lead">A local SSH workspace. Go owns SSH and the terminals; this window is a webview on a loopback server.</p>
		@settingsGroup("Version") {
			@statRow("Version", "about-version")
			@statRow("Build", "about-build")
		}
		@settingsGroup("Links") {
			<div class="pref-row">
				<div class="pref-copy">
					<div class="pref-title">Source</div>
					<p class="pref-desc k-mono k-wrap" id="about-repo">https://github.com/KJK-Nice/keel</p>
				</div>
				<button type="button" class="k-btn k-btn--sm" data-copy-from="about-repo">Copy link</button>
			</div>
			<div class="pref-row">
				<div class="pref-copy">
					<div class="pref-title">README</div>
					<p class="pref-desc k-mono k-wrap" id="about-readme">https://github.com/KJK-Nice/keel#readme</p>
				</div>
				<button type="button" class="k-btn k-btn--sm" data-copy-from="about-readme">Copy link</button>
			</div>
		}
	</div>
}

// statRow is a read-only row: a title and a value filled by JS.
templ statRow(title, id string) {
	<div class="pref-row">
		<div class="pref-copy">
			<div class="pref-title">{ title }</div>
		</div>
		<span class="k-mono k-pref-value" id={ id }></span>
	</div>
}
