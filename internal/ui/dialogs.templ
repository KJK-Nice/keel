package ui

import (
	"keel/components/alertdialog"
	"keel/components/button"
	"keel/components/checkbox"
	"keel/components/dialog"
	"keel/components/field"
	"keel/components/input"
	"keel/components/label"
	"keel/components/radiogroup"
	"keel/components/textarea"
	"keel/utils"
)

templ Dialogs(p PageProps) {
	<div class="modal-scrim" id="modal-scrim"></div>
	@hostDialog()
	@identityDialog()
	@tunnelDialog()
	@quickDialog()
	@joinDialog()
	@hostKeyDialog()
	@snippetDialog()
	@confirmDialog()
}

templ confirmDialog() {
	@alertdialog.AlertDialog(alertdialog.Props{ID: "confirm-dialog"}) {
		@button.Button(button.Props{
			ID:         "confirm-dialog-trigger",
			Type:       button.TypeButton,
			Class:      "sr-only",
			Attributes: mergeAttrs(alertdialog.Trigger(ctx), templ.Attributes{"tabindex": "-1"}),
		}) {
			Confirm
		}
		@alertdialog.Content() {
			@alertdialog.Header() {
				@alertdialog.Title(alertdialog.TitleProps{ID: "confirm-dialog-title"}) {
					Confirm
				}
				@alertdialog.Description(alertdialog.DescriptionProps{ID: "confirm-dialog-desc"}) {
					This cannot be undone.
				}
			}
			@alertdialog.Footer() {
				@alertdialog.Cancel() {
					Cancel
				}
				@alertdialog.Action(alertdialog.ActionProps{
					ID:         "confirm-dialog-ok",
					Variant:    button.VariantDestructive,
					Attributes: alertdialog.Close(ctx),
				}) {
					Remove
				}
			}
		}
	}
}

templ hostDialog() {
	<dialog class="modal" id="host-modal">
		<form id="host-form">
			@dialog.Header() {
				@dialog.Title(dialog.TitleProps{ID: "host-modal-title"}) {
					New host
				}
			}
			<input type="hidden" name="id"/>
			@labeledInput("Label", "name", "prod-api", true)
			@labeledInput("Group", "group", "Production", false)
			<div class="grid-2">
				@labeledInput("Hostname / IP", "address", "10.0.0.12", false)
				@field.Field() {
					@label.Label() {
						Port
					}
					@input.Input(input.Props{Name: "port", Type: "number", Value: "22", Attributes: templ.Attributes{"min": "0", "max": "65535"}})
				}
			</div>
			@labeledInput("Username", "username", "ubuntu", false)
			@field.Field() {
				@label.Label() {
					Authentication
				}
				<select name="authType" class="ui-select w-full">
					<option value="password">Password</option>
					<option value="key">Private key</option>
					<option value="identity">Keychain identity</option>
					<option value="local">Local shell</option>
				</select>
			}
			<div data-auth="identity">
				@field.Field() {
					@label.Label() {
						Identity
					}
					<select name="identityId" id="host-identity" class="ui-select w-full"></select>
				}
			</div>
			<div data-auth="password">
				@field.Field() {
					@label.Label() {
						Password
					}
					@input.Input(input.Props{Name: "password", Type: "password", Placeholder: "Leave blank to keep saved password", Attributes: templ.Attributes{"autocomplete": "new-password"}})
				}
			</div>
			<div data-auth="key">
				@field.Field() {
					@label.Label() {
						Private key
					}
					@textarea.Textarea(textarea.Props{Name: "privateKey", Rows: 6, Placeholder: "-----BEGIN OPENSSH PRIVATE KEY-----"})
				}
				@field.Field() {
					@label.Label() {
						Key passphrase
					}
					@input.Input(input.Props{Name: "passphrase", Type: "password", Placeholder: "Optional"})
				}
			</div>
			@field.Set(field.SetProps{Class: "swatches-set"}) {
				@field.Legend() {
					Color
				}
				@radiogroup.RadioGroup(radiogroup.Props{Name: "color", DefaultValue: "#5ee0b5", Class: "swatches-rg"}) {
					for _, c := range hostColors {
						@radiogroup.Item(radiogroup.ItemProps{
							Value:      c,
							Attributes: templ.Attributes{"style": "--swatch:" + c, "title": c},
						})
					}
				}
			}
			<div class="grid-2" data-ssh-only>
				@field.Field(field.Props{Orientation: field.OrientationHorizontal, Class: "items-center"}) {
					@checkbox.Checkbox(checkbox.Props{Name: "keepAlive", ID: "host-keepalive", DefaultChecked: true})
					@label.Label(label.Props{For: "host-keepalive"}) {
						Keepalive
					}
				}
				@field.Field() {
					@label.Label() {
						Keepalive interval (sec)
					}
					@input.Input(input.Props{Name: "keepAliveSec", Type: "number", Value: "30", Attributes: templ.Attributes{"min": "1", "max": "600"}})
				}
			</div>
			@field.Field(field.Props{Orientation: field.OrientationHorizontal, Class: "items-center", Attributes: templ.Attributes{"data-ssh-only": true}}) {
				@checkbox.Checkbox(checkbox.Props{Name: "autoReconnect", ID: "host-reconnect", DefaultChecked: true})
				@label.Label(label.Props{For: "host-reconnect"}) {
					Auto reconnect
				}
			}
			<div class="modal-actions">
				@button.Button(button.Props{ID: "host-cancel", Type: button.TypeButton, Variant: button.VariantGhost}) {
					Cancel
				}
				@button.Button(button.Props{Type: button.TypeSubmit}) {
					Save host
				}
			</div>
		</form>
	</dialog>
}

templ identityDialog() {
	<dialog class="modal" id="identity-modal">
		<form id="identity-form">
			@dialog.Header() {
				@dialog.Title(dialog.TitleProps{ID: "identity-modal-title"}) {
					New identity
				}
			}
			<input type="hidden" name="id"/>
			@labeledInput("Name", "name", "deploy key", true)
			@labeledInput("Username", "username", "ubuntu", false)
			@field.Field() {
				@label.Label() {
					Kind
				}
				<select name="kind" class="ui-select w-full">
					<option value="password">Password</option>
					<option value="key">Private key</option>
				</select>
			}
			<div data-ident="password">
				@field.Field() {
					@label.Label() {
						Password
					}
					@input.Input(input.Props{Name: "password", Type: "password", Placeholder: "Leave blank to keep saved password", Attributes: templ.Attributes{"autocomplete": "new-password"}})
				}
			</div>
			<div data-ident="key">
				@field.Field() {
					@label.Label() {
						Private key
					}
					@textarea.Textarea(textarea.Props{Name: "privateKey", Rows: 6, Placeholder: "-----BEGIN OPENSSH PRIVATE KEY-----"})
				}
				@field.Field() {
					@label.Label() {
						Key passphrase
					}
					@input.Input(input.Props{Name: "passphrase", Type: "password", Placeholder: "Optional"})
				}
			</div>
			<div class="modal-actions">
				@button.Button(button.Props{ID: "identity-cancel", Type: button.TypeButton, Variant: button.VariantGhost}) {
					Cancel
				}
				@button.Button(button.Props{Type: button.TypeSubmit}) {
					Save identity
				}
			</div>
		</form>
	</dialog>
}

templ tunnelDialog() {
	<dialog class="modal" id="tunnel-modal">
		<form id="tunnel-form">
			@dialog.Header() {
				@dialog.Title(dialog.TitleProps{ID: "tunnel-modal-title"}) {
					New forward
				}
			}
			<input type="hidden" name="id"/>
			@labeledInput("Name", "name", "db local", true)
			@field.Field() {
				@label.Label() {
					Host
				}
				<select name="hostId" id="tunnel-host" required class="ui-select w-full"></select>
			}
			@field.Field() {
				@label.Label() {
					Kind
				}
				<select name="kind" class="ui-select w-full">
					<option value="local">Local (−L)</option>
					<option value="remote">Remote (−R)</option>
					<option value="dynamic">Dynamic SOCKS5 (−D)</option>
				</select>
			}
			<div class="grid-2">
				@labeledInput("Bind address", "bindAddr", "", false)
				@field.Field() {
					@label.Label() {
						Bind port
					}
					@input.Input(input.Props{Name: "bindPort", Type: "number", Value: "0", Attributes: templ.Attributes{"min": "0", "max": "65535"}})
				}
			</div>
			<div class="grid-2" data-tunnel-dest>
				@labeledInput("Dest host", "destHost", "127.0.0.1", false)
				@field.Field() {
					@label.Label() {
						Dest port
					}
					@input.Input(input.Props{Name: "destPort", Type: "number", Value: "5432", Attributes: templ.Attributes{"min": "1", "max": "65535"}})
				}
			</div>
			@dialog.Description() {
				Bind 0.0.0.0 exposes the port on every interface.
			}
			<div class="modal-actions">
				@button.Button(button.Props{ID: "tunnel-cancel", Type: button.TypeButton, Variant: button.VariantGhost}) {
					Cancel
				}
				@button.Button(button.Props{Type: button.TypeSubmit}) {
					Save forward
				}
			</div>
		</form>
	</dialog>
}

templ quickDialog() {
	<dialog class="modal" id="quick-modal">
		<form id="quick-form">
			@dialog.Header() {
				@dialog.Title() {
					Quick connect
				}
				@dialog.Description() {
					Paste user@host or user@host:2222. Saved under Quick connect.
				}
			}
			@labeledInput("Target", "target", "ubuntu@192.168.1.20:22", true)
			@field.Field() {
				@label.Label() {
					Password
				}
				@input.Input(input.Props{Name: "password", Type: "password", Required: true})
			}
			<div class="modal-actions">
				@button.Button(button.Props{ID: "quick-cancel", Type: button.TypeButton, Variant: button.VariantGhost}) {
					Cancel
				}
				@button.Button(button.Props{Type: button.TypeSubmit}) {
					Connect
				}
			</div>
		</form>
	</dialog>
}

templ joinDialog() {
	<dialog class="modal" id="join-modal">
		<form id="join-form">
			@dialog.Header() {
				@dialog.Title() {
					Join a session
				}
				@dialog.Description() {
					Paste the Share link from the other Keel. You follow until they pass control. You never see their hosts or vault.
				}
			}
			@labeledInput("Join link", "url", "https://…/join?room=…", true)
			<div class="modal-actions">
				@button.Button(button.Props{ID: "join-cancel", Type: button.TypeButton, Variant: button.VariantGhost}) {
					Cancel
				}
				@button.Button(button.Props{Type: button.TypeSubmit}) {
					Join
				}
			</div>
		</form>
	</dialog>
}

templ hostKeyDialog() {
	<dialog class="modal" id="hostkey-modal">
		<form id="hostkey-form">
			@dialog.Header() {
				@dialog.Title(dialog.TitleProps{ID: "hostkey-title"}) {
					Unknown host key
				}
				@dialog.Description(dialog.DescriptionProps{ID: "hostkey-hint"}) {
					Trust this key once to connect. Keel will reject a different key later.
				}
			}
			<p class="hostkey-host" id="hostkey-host"></p>
			<p class="hostkey-fp" id="hostkey-fp"></p>
			<p class="hostkey-fp" id="hostkey-expected" hidden></p>
			<div class="modal-actions">
				@button.Button(button.Props{ID: "hostkey-cancel", Type: button.TypeButton, Variant: button.VariantGhost}) {
					Abort
				}
				@button.Button(button.Props{Type: button.TypeSubmit}) {
					Trust and connect
				}
			</div>
		</form>
	</dialog>
}

templ snippetDialog() {
	<dialog class="modal" id="snippet-modal">
		<form id="snippet-form">
			@dialog.Header() {
				@dialog.Title(dialog.TitleProps{ID: "snippet-modal-title"}) {
					New snippet
				}
			}
			<input type="hidden" name="id"/>
			@labeledInput("Name", "name", "disk usage", true)
			@field.Field() {
				@label.Label() {
					Command
				}
				@textarea.Textarea(textarea.Props{Name: "command", Rows: 4, Placeholder: "df -h", Attributes: templ.Attributes{"required": "required"}})
			}
			<div class="modal-actions">
				@button.Button(button.Props{ID: "snippet-cancel", Type: button.TypeButton, Variant: button.VariantGhost}) {
					Cancel
				}
				@button.Button(button.Props{Type: button.TypeSubmit}) {
					Save snippet
				}
			</div>
		</form>
	</dialog>
}

templ labeledInput(caption, name, placeholder string, required bool) {
	@field.Field() {
		@label.Label() {
			{ caption }
		}
		@input.Input(input.Props{
			Name:        name,
			Placeholder: placeholder,
			Required:    required,
			Value:       utils.IfElse(name == "bindAddr", "127.0.0.1", ""),
		})
	}
}
