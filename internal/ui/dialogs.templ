package ui

import (
	"keel/components/alertdialog"
	"keel/components/button"
	"keel/components/checkbox"
	"keel/components/dialog"
	"keel/components/field"
	"keel/components/input"
	"keel/components/label"
	"keel/components/radiogroup"
	selectcomp "keel/components/select"
	"keel/components/textarea"
	"keel/utils"
)

templ Dialogs(p PageProps) {
	<div class="modal-scrim" id="modal-scrim"></div>
	@hostDialog()
	@groupDialog()
	@identityDialog()
	@tunnelDialog()
	@quickDialog()
	@joinDialog()
	@hostKeyDialog()
	@snippetDialog()
	@notebookRenameDialog()
	@confirmDialog()
	@commandPalette()
	@ptyInjectDialog()
}

templ commandPalette() {
	<dialog class="cmd-palette k-palette" id="cmd-palette" aria-label="Command palette">
		<form id="cmd-palette-form">
			<div class="k-palette-search">
				<span class="k-i" aria-hidden="true">
					<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17.5 17.5L22 22M20 11C20 6.02944 15.9706 2 11 2C6.02944 2 2 6.02944 2 11C2 15.9706 6.02944 20 11 20C15.9706 20 20 15.9706 20 11Z"></path></svg>
				</span>
				<input
					id="cmd-palette-input"
					class="k-palette-input"
					type="search"
					placeholder="Run a command or connect a host…"
					autocomplete="off"
					role="combobox"
					aria-expanded="true"
					aria-controls="cmd-palette-list"
					aria-autocomplete="list"
				/>
				<span class="k-kbd">esc</span>
			</div>
			<div class="k-palette-list cmd-palette-list" id="cmd-palette-list" role="listbox"></div>
			<p class="k-palette-foot">
				<span><span class="k-kbd">↑</span><span class="k-kbd">↓</span>move</span>
				<span><span class="k-kbd">↵</span>open</span>
				<span><span class="k-kbd">⌥↵</span>open in split</span>
				<span class="k-palette-foot-end"><span class="k-kbd" id="cmd-palette-ask-kbd">⌘↵</span>ask agent</span>
			</p>
		</form>
	</dialog>
}

templ ptyInjectDialog() {
	<dialog class="modal" id="pty-inject-modal">
		<form id="pty-inject-form">
			@dialog.Header() {
				@dialog.Title(dialog.TitleProps{ID: "pty-inject-title"}) {
					Type into the terminal?
				}
				@dialog.Description(dialog.DescriptionProps{ID: "pty-inject-hint"}) {
					This sends keystrokes to the focused session. The current line is cleared first. Nothing is typed until you approve.
				}
			}
			<p class="hint">Session: <span id="pty-inject-session"></span></p>
			<pre class="pty-inject-preview" id="pty-inject-preview"></pre>
			<div class="modal-actions">
				@button.Button(button.Props{ID: "pty-inject-cancel", Type: button.TypeButton, Variant: button.VariantGhost}) {
					Cancel
				}
				@button.Button(button.Props{ID: "pty-inject-ok", Type: button.TypeButton}) {
					Type
				}
			</div>
		</form>
	</dialog>
}

templ confirmDialog() {
	@alertdialog.AlertDialog(alertdialog.Props{ID: "confirm-dialog"}) {
		@button.Button(button.Props{
			ID:         "confirm-dialog-trigger",
			Type:       button.TypeButton,
			Class:      "sr-only",
			Attributes: mergeAttrs(alertdialog.Trigger(ctx), templ.Attributes{"tabindex": "-1"}),
		}) {
			Confirm
		}
		@alertdialog.Content() {
			@alertdialog.Header() {
				@alertdialog.Title(alertdialog.TitleProps{ID: "confirm-dialog-title"}) {
					Confirm
				}
				@alertdialog.Description(alertdialog.DescriptionProps{ID: "confirm-dialog-desc"}) {
					This cannot be undone.
				}
			}
			@alertdialog.Footer() {
				@alertdialog.Cancel() {
					Cancel
				}
				@alertdialog.Action(alertdialog.ActionProps{
					ID:         "confirm-dialog-ok",
					Variant:    button.VariantDestructive,
					Attributes: alertdialog.Close(ctx),
				}) {
					Remove
				}
			}
		}
	}
}

// hostDialog is New host / Edit host (§5.8, Host board): 760px, two columns.
// Left: General, Connection. Right: Authentication, Session, Agent. The
// footer has Delete host (Edit only), Test connection, Cancel and Save.
//
// Fields keel serve has no support for yet are shown disabled with a note
// and carry no name, so they are never saved: Jump host, Startup command,
// the host key line and Test connection. Everything else maps onto
// store.Host.
templ hostDialog() {
	<dialog class="modal modal--host" id="host-modal">
		<form id="host-form">
			@dialog.Header() {
				@dialog.Title(dialog.TitleProps{ID: "host-modal-title"}) {
					New host
				}
			}
			<input type="hidden" name="id"/>
			<div class="k-start-notes" id="host-import-note" role="status" hidden></div>
			<div class="k-host-cols">
				<div class="k-host-col">
					<div class="k-menu-label">General</div>
					@labeledInput("host-name", "Label", "name", "prod-api", true)
					@labeledSelect("host-parent-group", "Folder", "groupId", "No group", "", false, []string{""}, []string{"No group"})
					@field.Set(field.SetProps{Class: "swatches-set"}) {
						@field.Legend() {
							Color
						}
						@radiogroup.RadioGroup(radiogroup.Props{Name: "color", DefaultValue: "#5ee0b5", Class: "swatches-rg"}) {
							for _, c := range hostColors {
								@radiogroup.Item(radiogroup.ItemProps{
									Value:      c,
									Attributes: templ.Attributes{"style": "--swatch:" + c, "title": c},
								})
							}
						}
					}
					@labeledInput("host-tags", "Tags", "tags", "prod, gpu", false)
					<div class="k-menu-label">Connection</div>
					<div class="grid-2">
						@labeledInput("host-address", "Hostname / IP", "address", "10.0.0.12", false)
						@labeledNumber("host-port", "Port", "port", "22", "0", "65535")
					</div>
					@labeledInput("host-username", "Username", "username", "ubuntu", false)
					<div class="k-field" data-ssh-only>
						<label class="k-label" for="host-jump">Jump host</label>
						<input class="k-input" id="host-jump" placeholder="None" disabled/>
						<span class="k-help">Coming soon. A jump host in ~/.ssh/config is skipped on import for now.</span>
					</div>
				</div>
				<div class="k-host-col">
					<div class="k-menu-label">Authentication</div>
					@labeledSelect("host-auth-type", "Authentication", "authType", "Auth", "password", false, []string{"password", "key", "identity", "local"}, []string{"Password", "Private key", "Keychain identity", "Local shell"})
					<div data-auth="identity">
						@labeledSelect("host-identity", "Identity", "identityId", "Identity", "", false, []string{""}, []string{"No identities — add in Keychain"})
					</div>
					<div data-auth="password">
						@labeledPassword("host-password", "Password", "password", "Leave blank to keep saved password", false)
					</div>
					<div data-auth="key">
						@labeledTextarea("host-private-key", "Private key", "privateKey", "-----BEGIN OPENSSH PRIVATE KEY-----", 6, false)
						@labeledPassword("host-passphrase", "Key passphrase", "passphrase", "Optional", false)
					</div>
					<div class="k-field" data-ssh-only>
						<span class="k-label">Host key</span>
						<span class="k-help">Trusted on first connect; Keel asks again if it changes. The fingerprint is not listed here yet.</span>
					</div>
					<div class="k-menu-label" data-ssh-only>Session</div>
					<div class="k-field" data-ssh-only>
						<label class="k-label" for="host-startup">Startup command</label>
						<input class="k-input" id="host-startup" placeholder="tmux new -A -s main" disabled/>
						<span class="k-help">Coming soon.</span>
					</div>
					<div class="grid-2" data-ssh-only>
						@field.Field(field.Props{Orientation: field.OrientationHorizontal, Class: "items-center"}) {
							@checkbox.Checkbox(checkbox.Props{Name: "keepAlive", ID: "host-keepalive", DefaultChecked: true})
							@label.Label(label.Props{For: "host-keepalive"}) {
								Keepalive
							}
						}
						@labeledNumber("host-keepalive-sec", "Keepalive interval (sec)", "keepAliveSec", "30", "1", "600")
					</div>
					@field.Field(field.Props{Orientation: field.OrientationHorizontal, Class: "items-center", Attributes: templ.Attributes{"data-ssh-only": true}}) {
						@checkbox.Checkbox(checkbox.Props{Name: "autoReconnect", ID: "host-reconnect", DefaultChecked: true})
						@label.Label(label.Props{For: "host-reconnect"}) {
							Auto reconnect
						}
					}
					<div class="k-menu-label">Agent</div>
					<div class="k-field k-field--row">
						<div class="k-field-copy">
							<span id="host-agent-readable-label">Agent can read this host's panes</span>
							<span class="k-help">You still choose panes per conversation.</span>
						</div>
						<button type="button" class="k-switch" role="switch" id="host-agent-readable" aria-checked="true" aria-labelledby="host-agent-readable-label"></button>
					</div>
					<div class="k-field k-field--row">
						<div class="k-field-copy">
							<span id="host-production-label">Treat as production</span>
							<span class="k-help">Suggestions that change state need ⇧⇥ and show a red edge. On by default in a group named production.</span>
						</div>
						<button type="button" class="k-switch" role="switch" id="host-production" aria-checked="false" aria-labelledby="host-production-label"></button>
					</div>
				</div>
			</div>
			<div class="k-host-foot">
				<button type="button" class="k-btn k-btn--danger k-btn--sm" id="host-delete" hidden>Delete host</button>
				<span class="k-spacer"></span>
				<span class="k-help" id="host-test-note">Test connection: coming soon</span>
				<button type="button" class="k-btn" id="host-test" disabled>Test connection</button>
				@button.Button(button.Props{ID: "host-cancel", Type: button.TypeButton, Variant: button.VariantGhost}) {
					Cancel
				}
				<button type="submit" class="k-btn k-btn--primary" aria-label="Save host">
					Save host
					<span class="k-kbd" id="host-save-kbd" aria-hidden="true">⌘↵</span>
				</button>
			</div>
		</form>
	</dialog>
}

templ groupDialog() {
	<dialog class="modal" id="group-modal">
		<form id="group-form">
			@dialog.Header() {
				@dialog.Title(dialog.TitleProps{ID: "group-modal-title"}) {
					New group
				}
				@dialog.Description() {
					Label plus an optional parent. Hosts in this group and its subgroups show on the Hosts screen.
				}
			}
			<input type="hidden" name="id"/>
			@labeledInput("group-label", "Label", "name", "Production", true)
			@labeledSelect("group-parent", "Parent Group", "parentId", "No parent", "", false, []string{""}, []string{"No parent"})
			<div class="modal-actions">
				@button.Button(button.Props{ID: "group-cancel", Type: button.TypeButton, Variant: button.VariantGhost}) {
					Cancel
				}
				@button.Button(button.Props{Type: button.TypeSubmit}) {
					Save group
				}
			</div>
		</form>
	</dialog>
}

templ identityDialog() {
	<dialog class="modal" id="identity-modal">
		<form id="identity-form">
			@dialog.Header() {
				@dialog.Title(dialog.TitleProps{ID: "identity-modal-title"}) {
					New identity
				}
			}
			<input type="hidden" name="id"/>
			@labeledInput("ident-name", "Name", "name", "deploy key", true)
			@labeledInput("ident-username", "Username", "username", "ubuntu", false)
			@labeledSelect("ident-kind", "Kind", "kind", "Kind", "password", false, []string{"password", "key"}, []string{"Password", "Private key"})
			<div data-ident="password">
				@labeledPassword("ident-password", "Password", "password", "Leave blank to keep saved password", false)
			</div>
			<div data-ident="key">
				@labeledTextarea("ident-private-key", "Private key", "privateKey", "-----BEGIN OPENSSH PRIVATE KEY-----", 6, false)
				@labeledPassword("ident-passphrase", "Key passphrase", "passphrase", "Optional", false)
			</div>
			<div class="modal-actions">
				@button.Button(button.Props{ID: "identity-cancel", Type: button.TypeButton, Variant: button.VariantGhost}) {
					Cancel
				}
				@button.Button(button.Props{Type: button.TypeSubmit}) {
					Save identity
				}
			</div>
		</form>
	</dialog>
}

templ tunnelDialog() {
	<dialog class="modal" id="tunnel-modal">
		<form id="tunnel-form">
			@dialog.Header() {
				@dialog.Title(dialog.TitleProps{ID: "tunnel-modal-title"}) {
					New forward
				}
			}
			<input type="hidden" name="id"/>
			@labeledInput("tunnel-name", "Name", "name", "db local", true)
			@labeledSelect("tunnel-host", "Host", "hostId", "Host", "", true, []string{""}, []string{"Add an SSH host first"})
			@labeledSelect("tunnel-kind", "Kind", "kind", "Kind", "local", false, []string{"local", "remote", "dynamic"}, []string{"Local (−L)", "Remote (−R)", "Dynamic SOCKS5 (−D)"})
			<div class="grid-2">
				@labeledInput("tunnel-bind-addr", "Bind address", "bindAddr", "", false)
				@labeledNumber("tunnel-bind-port", "Bind port", "bindPort", "0", "0", "65535")
			</div>
			<div class="grid-2" data-tunnel-dest>
				@labeledInput("tunnel-dest-host", "Dest host", "destHost", "127.0.0.1", false)
				@labeledNumber("tunnel-dest-port", "Dest port", "destPort", "5432", "1", "65535")
			</div>
			@dialog.Description() {
				Bind 0.0.0.0 exposes the port on every interface.
			}
			<div class="modal-actions">
				@button.Button(button.Props{ID: "tunnel-cancel", Type: button.TypeButton, Variant: button.VariantGhost}) {
					Cancel
				}
				@button.Button(button.Props{Type: button.TypeSubmit}) {
					Save forward
				}
			</div>
		</form>
	</dialog>
}

templ quickDialog() {
	<dialog class="modal" id="quick-modal">
		<form id="quick-form">
			@dialog.Header() {
				@dialog.Title() {
					Quick connect
				}
				@dialog.Description() {
					Paste user@host or user@host:2222. Saved under Quick connect.
				}
			}
			<div class="k-start-notes" id="quick-note" role="status" hidden></div>
			@labeledInput("quick-target", "Target", "target", "ubuntu@192.168.1.20:22", true)
			@labeledPassword("quick-password", "Password", "password", "", true)
			<div class="modal-actions">
				@button.Button(button.Props{ID: "quick-cancel", Type: button.TypeButton, Variant: button.VariantGhost}) {
					Cancel
				}
				@button.Button(button.Props{Type: button.TypeSubmit}) {
					Connect
				}
			</div>
		</form>
	</dialog>
}

templ joinDialog() {
	<dialog class="modal" id="join-modal">
		<form id="join-form">
			@dialog.Header() {
				@dialog.Title() {
					Join a session
				}
				@dialog.Description() {
					Paste the Share link from the other Keel. You follow until they pass control. You never see their hosts or vault.
				}
			}
			@labeledInput("join-url", "Join link", "url", "https://…/join?room=…", true)
			<div class="modal-actions">
				@button.Button(button.Props{ID: "join-cancel", Type: button.TypeButton, Variant: button.VariantGhost}) {
					Cancel
				}
				@button.Button(button.Props{Type: button.TypeSubmit}) {
					Join
				}
			</div>
		</form>
	</dialog>
}

templ hostKeyDialog() {
	<dialog class="modal" id="hostkey-modal">
		<form id="hostkey-form">
			@dialog.Header() {
				@dialog.Title(dialog.TitleProps{ID: "hostkey-title"}) {
					Unknown host key
				}
				@dialog.Description(dialog.DescriptionProps{ID: "hostkey-hint"}) {
					Trust this key once to connect. Keel will reject a different key later.
				}
			}
			<p class="hostkey-host" id="hostkey-host"></p>
			<p class="hostkey-fp" id="hostkey-fp"></p>
			<p class="hostkey-fp" id="hostkey-expected" hidden></p>
			<div class="modal-actions">
				@button.Button(button.Props{ID: "hostkey-cancel", Type: button.TypeButton, Variant: button.VariantGhost}) {
					Abort
				}
				@button.Button(button.Props{Type: button.TypeSubmit}) {
					Trust and connect
				}
			</div>
		</form>
	</dialog>
}

templ snippetDialog() {
	<dialog class="modal" id="snippet-modal">
		<form id="snippet-form">
			@dialog.Header() {
				@dialog.Title(dialog.TitleProps{ID: "snippet-modal-title"}) {
					New snippet
				}
			}
			<input type="hidden" name="id"/>
			@labeledInput("snippet-name", "Name", "name", "disk usage", true)
			@labeledTextarea("snippet-command", "Command", "command", "df -h", 4, true)
			<div class="modal-actions">
				@button.Button(button.Props{ID: "snippet-cancel", Type: button.TypeButton, Variant: button.VariantGhost}) {
					Cancel
				}
				@button.Button(button.Props{Type: button.TypeSubmit}) {
					Save snippet
				}
			</div>
		</form>
	</dialog>
}

templ notebookRenameDialog() {
	<dialog class="modal" id="notebook-rename-modal">
		<form id="notebook-rename-form">
			@dialog.Header() {
				@dialog.Title(dialog.TitleProps{ID: "notebook-rename-title"}) {
					Rename notebook
				}
			}
			<input type="hidden" name="id"/>
			@labeledInput("notebook-rename-name", "Name", "name", "Notebook", true)
			<div class="modal-actions">
				@button.Button(button.Props{ID: "notebook-rename-cancel", Type: button.TypeButton, Variant: button.VariantGhost}) {
					Cancel
				}
				@button.Button(button.Props{Type: button.TypeSubmit}) {
					Rename
				}
			</div>
		</form>
	</dialog>
}

templ labeledInput(id, caption, name, placeholder string, required bool) {
	@field.Field() {
		@label.Label(label.Props{For: id}) {
			{ caption }
		}
		@input.Input(input.Props{
			ID:          id,
			Name:        name,
			Placeholder: placeholder,
			Required:    required,
			Value:       utils.IfElse(name == "bindAddr", "127.0.0.1", ""),
		})
	}
}

templ labeledNumber(id, caption, name, value, min, max string) {
	@field.Field() {
		@label.Label(label.Props{For: id}) {
			{ caption }
		}
		@input.Input(input.Props{
			ID:         id,
			Name:       name,
			Type:       "number",
			Value:      value,
			Attributes: templ.Attributes{"min": min, "max": max},
		})
	}
}

templ labeledPassword(id, caption, name, placeholder string, required bool) {
	@field.Field() {
		@label.Label(label.Props{For: id}) {
			{ caption }
		}
		@input.Input(input.Props{
			ID:          id,
			Name:        name,
			Type:        "password",
			Placeholder: placeholder,
			Required:    required,
			Attributes:  templ.Attributes{"autocomplete": "new-password"},
		})
	}
}

templ labeledTextarea(id, caption, name, placeholder string, rows int, required bool) {
	@field.Field() {
		@label.Label(label.Props{For: id}) {
			{ caption }
		}
		@textarea.Textarea(textarea.Props{
			ID:          id,
			Name:        name,
			Rows:        rows,
			Placeholder: placeholder,
			Attributes:  utils.IfElse(required, templ.Attributes{"required": "required"}, templ.Attributes{}),
		})
	}
}

templ labeledSelect(id, caption, name, placeholder, current string, required bool, values []string, labels []string) {
	@field.Field() {
		@label.Label(label.Props{For: id}) {
			{ caption }
		}
		@formSelect(id, name, "", placeholder, current, required, "w-full min-w-0", selectcomp.AlignStart, values, labels)
	}
}
