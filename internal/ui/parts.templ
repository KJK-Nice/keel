package ui

import (
	"keel/components/button"
	"keel/components/buttongroup"
	"keel/components/contextmenu"
	"keel/components/dropdownmenu"
	"keel/components/empty"
	"keel/components/icon"
	"keel/components/kbd"
	selectcomp "keel/components/select"
	"keel/components/tooltip"
)

templ tabContextMenu() {
	@contextmenu.ContextMenu(contextmenu.Props{ID: "tab-ctx"}) {
		@contextmenu.Trigger(contextmenu.TriggerProps{ID: "tab-ctx-trigger", Class: "tabs-scroller"}) {
			<div class="tabs" id="tabs"></div>
		}
		@contextmenu.Content(contextmenu.ContentProps{Class: "min-w-44"}) {
			@contextmenu.Item(contextmenu.ItemProps{Attributes: templ.Attributes{"data-tab-action": "rename"}}) {
				Rename tab
			}
			@contextmenu.Separator(contextmenu.SeparatorProps{Attributes: templ.Attributes{"data-tab-menu-sep": "rename"}})
			@contextmenu.Item(contextmenu.ItemProps{Attributes: templ.Attributes{"data-tab-action": "close"}}) {
				Close
			}
			@contextmenu.Item(contextmenu.ItemProps{Attributes: templ.Attributes{"data-tab-action": "close-others"}}) {
				Close Others
			}
			@contextmenu.Item(contextmenu.ItemProps{Attributes: templ.Attributes{"data-tab-action": "close-right"}}) {
				Close to the Right
			}
			@contextmenu.Item(contextmenu.ItemProps{Attributes: templ.Attributes{"data-tab-action": "close-all"}}) {
				Close All
			}
		}
	}
}

templ hintKbd(key string) {
	@kbd.Kbd(kbd.Props{Class: "kbd-hint", Attributes: templ.Attributes{"aria-hidden": "true"}}) {
		{ key }
	}
}

templ vaultToolbar() {
	<div class="flex flex-wrap items-center justify-between gap-2">
		<div class="flex min-w-0 flex-1 flex-wrap items-center gap-2">
			{ children... }
		</div>
		@viewModeToggle()
	</div>
}

templ viewModeToggle() {
	@buttongroup.ButtonGroup(buttongroup.Props{
		Class:      "shrink-0",
		Attributes: templ.Attributes{"aria-label": "View mode"},
	}) {
		@tooltip.Tooltip() {
			@button.Button(button.Props{
				Variant: button.VariantOutline,
				Size:    button.SizeIcon,
				Attributes: mergeAttrs(tooltip.Trigger(ctx), templ.Attributes{
					"data-vault-view-btn": "card",
					"aria-label":          "Card view",
					"aria-pressed":        "true",
				}),
			}) {
				@icon.GridView()
			}
			@tooltip.Content() {
				Card view
			}
		}
		@tooltip.Tooltip() {
			@button.Button(button.Props{
				Variant: button.VariantOutline,
				Size:    button.SizeIcon,
				Attributes: mergeAttrs(tooltip.Trigger(ctx), templ.Attributes{
					"data-vault-view-btn": "list",
					"aria-label":          "List view",
					"aria-pressed":        "false",
				}),
			}) {
				@icon.ListView()
			}
			@tooltip.Content() {
				List view
			}
		}
	}
}

templ emptyBox(id, title, desc string) {
	@empty.Empty(empty.Props{ID: id}) {
		@empty.Header() {
			@empty.Title() {
				{ title }
			}
			@empty.Description() {
				{ desc }
			}
		}
	}
}

templ rowMenu(editKey, editID, delKey, delID string) {
	@dropdownmenu.DropdownMenu() {
		@button.Button(button.Props{
			Variant:    button.VariantGhost,
			Size:       button.SizeIconXs,
			Class:      "tiny",
			Attributes: mergeAttrs(dropdownmenu.Trigger(ctx), templ.Attributes{"aria-label": "Actions"}),
		}) {
			@icon.EllipsisVertical()
		}
		@dropdownmenu.Content(dropdownmenu.ContentProps{Align: dropdownmenu.AlignEnd, Side: dropdownmenu.SideBottom, Class: "w-auto min-w-max"}) {
			@dropdownmenu.Item(dropdownmenu.ItemProps{Attributes: templ.Attributes{editKey: editID}}) {
				Edit
			}
			if delKey != "" {
				@dropdownmenu.Separator()
				@dropdownmenu.Item(dropdownmenu.ItemProps{
					Variant:    dropdownmenu.ItemVariantDestructive,
					Attributes: templ.Attributes{delKey: delID},
				}) {
					Remove
				}
			}
		}
	}
}

templ settingsSelect(id, name, aria, placeholder, current string, values []string, labels []string) {
	@formSelect(id, name, aria, placeholder, current, false, "min-w-[10.5rem]", selectcomp.AlignEnd, values, labels)
}

templ formSelect(id, name, aria, placeholder, current string, required bool, class string, align selectcomp.Align, values []string, labels []string) {
	{{ attrs := templ.Attributes{} }}
	if aria != "" {
		{{ attrs["aria-label"] = aria }}
	}
	@selectcomp.Select(selectcomp.Props{Name: name, DefaultValue: current, Required: required}) {
		@selectcomp.Trigger(selectcomp.TriggerProps{ID: id, Class: class, Attributes: attrs}) {
			@selectcomp.Value(selectcomp.ValueProps{Placeholder: placeholder})
		}
		@selectcomp.Content(selectcomp.ContentProps{Align: align, DisableAlignItemWithTrigger: true}) {
			@selectcomp.Group() {
				for i, v := range values {
					@selectcomp.Item(selectcomp.ItemProps{Value: v}) {
						{ labels[i] }
					}
				}
			}
		}
	}
}
