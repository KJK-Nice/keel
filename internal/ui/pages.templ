package ui

import (
	"keel/components/aspectratio"
	"keel/components/icon"
	"keel/components/slider"
	switchcomp "keel/components/switch"
)

// Pages holds the tab pages (docs/ui-redesign.md §4): Keychain, Port
// forwarding, Snippets, Notebooks, Logs and Settings. Each opens as its
// own tab, one instance each; term.js moves the page into the tab while it
// is open and back here when the tab closes.
templ Pages(p PageProps) {
	<div class="pages" id="pages" hidden>
		@KeychainPage(p)
		@ForwardsPage(p)
		@SnippetsPage(p)
		@NotebooksPage(p)
		@LogsPage(p)
		@SettingsPage()
		@AgentPage()
		@RunbooksPage()
	</div>
}

templ pageHead(title, desc string) {
	<div class="k-page-head">
		<div class="k-page-intro">
			<h1 class="k-page-title">{ title }</h1>
			<p class="k-page-desc">{ desc }</p>
		</div>
		{ children... }
	</div>
}

// newItemButton is a page's primary action; ⌘N runs it while the page is
// the selected tab.
templ newItemButton(id, label string) {
	<button type="button" class="k-btn k-btn--primary" id={ id } data-kbd="N">
		@icon.Add01()
		{ label }
		<kbd class="k-kbd" aria-hidden="true">⌘N</kbd>
	</button>
}

templ filterInput(label, scope string) {
	<div class="k-inputgroup k-filter">
		<span class="k-addon" aria-hidden="true">
			@icon.Search01()
		</span>
		<input
			class="k-input"
			type="search"
			placeholder={ label }
			aria-label={ label }
			autocomplete="off"
			spellcheck="false"
			data-list-filter={ scope }
			data-bind={ "_" + scope + "Filter" }
		/>
	</div>
}

templ splitHead(title, buttonID, buttonLabel, filterLabel, scope string) {
	<div class="k-split-head">
		<div class="k-split-titlerow">
			<h1 class="k-split-title">{ title }</h1>
			<button type="button" class="k-btn k-btn--sm" id={ buttonID } data-kbd="N">
				@icon.Add01()
				{ buttonLabel }
			</button>
		</div>
		@filterInput(filterLabel, scope)
	</div>
}

templ KeychainPage(p PageProps) {
	<section class="k-page k-page--split" id="page-keychain" data-page="keychain" aria-label="Keychain">
		<div class="k-split">
			<div class="k-split-list">
				@splitHead("Keychain", "btn-new-identity", "New identity", "Filter identities", "identity")
				@IdentityList(p)
			</div>
			<div class="k-split-detail" id="identity-detail"></div>
		</div>
	</section>
}

templ ForwardsPage(p PageProps) {
	<section class="k-page" id="page-forwards" data-page="forwards" aria-label="Port forwarding">
		@pageHead("Port forwarding", "Each forward opens its own SSH connection. It keeps running when you close the window.") {
			@newItemButton("btn-new-tunnel", "New forward")
		}
		<div class="k-toolbar">
			@filterInput("Filter forwards", "tunnel")
			<div class="k-chips" role="group" aria-label="Show forwards">
				<button type="button" class="k-chip" data-on:click="$_tunnelState = 'all'" data-attr:aria-pressed="String($_tunnelState === 'all')">All <span data-tunnel-count="all"></span></button>
				<button type="button" class="k-chip" data-on:click="$_tunnelState = 'running'" data-attr:aria-pressed="String($_tunnelState === 'running')">Running <span data-tunnel-count="running"></span></button>
				<button type="button" class="k-chip" data-on:click="$_tunnelState = 'stopped'" data-attr:aria-pressed="String($_tunnelState === 'stopped')">Stopped <span data-tunnel-count="stopped"></span></button>
			</div>
		</div>
		<table class="k-table">
			<thead>
				<tr>
					<th>Name</th>
					<th>Type</th>
					<th>Route</th>
					<th>Through</th>
					<th>Status</th>
					<th class="k-cell-end">On</th>
					<th class="k-cell-end"><span class="k-sr">Actions</span></th>
				</tr>
			</thead>
			@TunnelList(p)
		</table>
	</section>
}

templ SnippetsPage(p PageProps) {
	<section class="k-page k-page--split" id="page-snippets" data-page="snippets" aria-label="Snippets">
		<div class="k-split">
			<div class="k-split-list">
				@splitHead("Snippets", "btn-new-snippet", "New snippet", "Filter snippets", "snippet")
				@SnippetList(p)
			</div>
			<div class="k-split-detail">
				<form class="k-editor" id="snippet-editor" hidden data-on:submit__prevent="@post('/ui/forms/snippet-editor', {contentType: 'form'})" data-indicator:_saving>
					<input type="hidden" name="id"/>
					<div class="k-editor-head">
						<input class="k-input k-editor-title" name="name" aria-label="Snippet name" autocomplete="off" required/>
						<button type="button" class="k-btn" id="snippet-editor-run" data-run="">Type into pane…</button>
						<button type="submit" class="k-btn k-btn--primary" id="snippet-editor-save" data-attr:disabled="$_saving">
							Save
							<kbd class="k-kbd" aria-hidden="true">⌘S</kbd>
						</button>
					</div>
					<div class="k-field">
						<label class="k-label" for="snippet-editor-command">Commands</label>
						<textarea
							class="k-textarea k-textarea--mono k-editor-body"
							id="snippet-editor-command"
							name="command"
							rows="6"
							spellcheck="false"
							autocomplete="off"
						></textarea>
						<span class="k-help">One command per line. Each line ends with Enter when typed.</span>
					</div>
					<div class="k-field">
						<span class="k-label">Preview of what gets typed</span>
						<pre class="k-bytes" id="snippet-editor-preview"></pre>
						<span class="k-help" id="snippet-editor-count"></span>
					</div>
					<div class="k-field k-field--row">
						<div class="k-field">
							<span class="k-label" id="snippet-editor-agent-label">Let the agent suggest this snippet</span>
							<span class="k-help" id="snippet-editor-agent-help">⇥ can offer it when your words match. One-line commands without { "{{var}}" } fields only. When on, its text is sent, redacted, to TypeSafe Jev.</span>
						</div>
						<button
							type="button"
							class="k-switch"
							role="switch"
							id="snippet-editor-agent"
							aria-checked="false"
							aria-labelledby="snippet-editor-agent-label"
							aria-describedby="snippet-editor-agent-help"
							data-switch-field="agentUsable"
						></button>
						<input type="hidden" name="agentUsable" value="false"/>
					</div>
					<p id="snippet-editor-form-error" class="k-error" role="alert" hidden></p>
					<div class="k-editor-foot">
						<span class="k-spacer"></span>
						<button type="button" class="k-btn k-btn--danger k-btn--sm" id="snippet-editor-delete" data-delete-snippet="">Delete snippet</button>
					</div>
				</form>
				<div class="k-detail-empty" id="snippet-editor-empty">
					<p class="k-help">Select a snippet to edit it, or add one with New snippet.</p>
				</div>
			</div>
		</div>
	</section>
}

templ NotebooksPage(p PageProps) {
	<section class="k-page" id="page-notebooks" data-page="notebooks" aria-label="Notebooks">
		@pageHead("Notebooks", "Markdown runbooks. Fenced sh and bash blocks fill a terminal's input; nothing is typed until you confirm.") {
			@newItemButton("btn-new-notebook", "New notebook")
		}
		<div class="k-toolbar">
			@filterInput("Filter notebooks", "notebook")
		</div>
		@NotebookList(p)
	</section>
}

templ LogsPage(p PageProps) {
	<section class="k-page" id="page-logs" data-page="logs" aria-label="Logs">
		@pageHead("Logs", "What Keel did on this machine, newest first. Secrets are never written here.") {
			<button type="button" class="k-btn" id="btn-refresh-logs" data-on:click="@get('/ui/logs')">Refresh</button>
		}
		<div class="k-toolbar">
			<div class="k-inputgroup k-filter">
				<span class="k-addon" aria-hidden="true">
					@icon.Search01()
				</span>
				<input
					id="log-filter"
					class="k-input"
					type="search"
					placeholder="Search events"
					aria-label="Search events"
					autocomplete="off"
					spellcheck="false"
					value={ p.LogFilter }
					data-bind="logFilter"
					data-on:input__debounce.120ms="@get('/ui/logs')"
				/>
			</div>
			<div class="k-chips" role="group" aria-label="Show events">
				<button type="button" class="k-chip" data-on:click="$_logKind = 'all'" data-attr:aria-pressed="String($_logKind === 'all')">All</button>
				<button type="button" class="k-chip" data-on:click="$_logKind = 'sessions'" data-attr:aria-pressed="String($_logKind === 'sessions')">Sessions</button>
				<button type="button" class="k-chip" data-on:click="$_logKind = 'forwards'" data-attr:aria-pressed="String($_logKind === 'forwards')">Forwards</button>
				<button type="button" class="k-chip" data-on:click="$_logKind = 'vault'" data-attr:aria-pressed="String($_logKind === 'vault')">Vault</button>
				<button type="button" class="k-chip" data-on:click="$_logKind = 'agent'" data-attr:aria-pressed="String($_logKind === 'agent')">Agent</button>
			</div>
		</div>
		<table class="k-table k-table--log">
			<thead>
				<tr>
					<th>Time</th>
					<th>Kind</th>
					<th>Target</th>
					<th>Event</th>
				</tr>
			</thead>
			@LogList(p)
		</table>
	</section>
}

templ SettingsPage() {
	<section class="k-page k-page--settings" id="page-settings" data-page="settings" aria-label="Settings">
		<nav class="k-rail settings-rail" aria-label="Settings sections">
			<div class="k-rail-label">Settings</div>
			<div class="k-inputgroup k-rail-search">
				<span class="k-addon" aria-hidden="true">
					@icon.Search01()
				</span>
				<input
					id="settings-search"
					class="k-input"
					type="search"
					placeholder="Search settings"
					aria-label="Search settings"
					autocomplete="off"
					spellcheck="false"
				/>
			</div>
			<div class="settings-nav-list" role="tablist" aria-orientation="vertical">
				@settingsNav("appearance", "Appearance", true)
				@settingsNav("terminal", "Terminal", false)
				@settingsNav("keyboard", "Keyboard", false)
				@settingsNav("agent", "Agent", false)
				@settingsNav("sharing", "Sharing", false)
				@settingsNav("vault", "Vault & security", false)
				@settingsNav("runtime", "Runtime", false)
			</div>
			<div class="k-rail-spacer"></div>
			<button type="button" class="k-rail-item settings-nav" data-settings-section="about" role="tab" aria-selected="false" id="settings-nav-about">
				About Keel
				<span class="k-rail-count" id="settings-about-count"></span>
			</button>
		</nav>
		<div class="k-settings-main">
			<form class="k-settings-form" id="settings-form">
				<div class="settings-panel is-active" data-settings-panel="appearance" role="tabpanel">
					<h1 class="k-page-title">Appearance</h1>
					@settingsGroup("Display") {
						<div class="pref-row">
							<div class="pref-copy">
								<div class="pref-title">Theme</div>
								<p class="pref-desc">Light, dark, or follow the system.</p>
							</div>
							@settingsSelect("set-theme", "theme", "Color theme", "Theme", "system", []string{"system", "light", "dark"}, []string{"System", "Light", "Dark"})
						</div>
						<div class="pref-row">
							<div class="pref-copy">
								<div class="pref-title">UI size</div>
								<p class="pref-desc">Tabs, settings, and chrome. 11–16px. Terminal size is separate.</p>
							</div>
							<div class="pref-slider">
								@slider.Slider(slider.Props{
									ID:           "set-ui-size",
									Min:          11,
									Max:          16,
									Step:         1,
									DefaultValue: []float64{12},
									Class:        "w-36",
								})
								<output id="set-ui-size-out">12</output>
							</div>
						</div>
						<div class="pref-row">
							<div class="pref-copy">
								<div class="pref-title">Font smoothing</div>
								<p class="pref-desc">How chrome text is drawn. Antialiased is thinner on dark UI.</p>
							</div>
							@settingsSelect("set-smooth", "smoothing", "Font smoothing", "Smoothing", "antialiased", []string{"antialiased", "subpixel", "none"}, []string{"Antialiased", "Subpixel", "None"})
						</div>
					}
				</div>
				<div class="settings-panel" data-settings-panel="terminal" role="tabpanel" hidden>
					<h1 class="k-page-title">Terminal</h1>
					@settingsGroup("Session") {
						<div class="pref-row">
							<div class="pref-copy">
								<div class="pref-title">Font</div>
								<p class="pref-desc">Monospace face used in every pane.</p>
							</div>
							@settingsSelect("set-font", "font", "Terminal font", "Font", "jetbrains", []string{"jetbrains", "ibmplex", "menlo", "consolas", "system"}, []string{"JetBrains Mono", "IBM Plex Mono", "Menlo / SF Mono", "Consolas", "System mono"})
						</div>
						<div class="pref-row">
							<div class="pref-copy">
								<div class="pref-title">Text size</div>
								<p class="pref-desc">10–22px. ⌘+ / ⌘− / ⌘0 also change size.</p>
							</div>
							<div class="pref-slider" data-kbd="+">
								@slider.Slider(slider.Props{
									ID:           "set-size",
									Min:          10,
									Max:          22,
									Step:         1,
									DefaultValue: []float64{12},
									Class:        "w-36",
								})
								<output id="set-size-out">12</output>
								@hintKbd("+ − 0")
							</div>
						</div>
						<div class="pref-row pref-row-preview">
							@aspectratio.AspectRatio(aspectratio.Props{Ratio: "16/5", Class: "pref-preview overflow-hidden w-full"}) {
								<pre id="term-preview" class="absolute inset-0 m-0 flex items-center px-3">guest@keel:~ $ ssh prod-api</pre>
							}
						</div>
					}
					@settingsGroup("Input") {
						<div class="pref-row">
							<div class="pref-copy">
								<div class="pref-title">Copy on select</div>
								<p class="pref-desc">Copy terminal selection to the clipboard.</p>
							</div>
							@switchcomp.Switch(switchcomp.Props{ID: "set-copy"})
						</div>
						<div class="pref-row">
							<div class="pref-copy">
								<div class="pref-title">Right-click to paste</div>
								<p class="pref-desc">Paste clipboard into the focused pane.</p>
							</div>
							@switchcomp.Switch(switchcomp.Props{ID: "set-paste"})
						</div>
					}
				</div>
				@keyboardSettingsPanel()
				@agentSettingsPanel()
				@sharingSettingsPanel()
				@vaultSettingsPanel()
				@runtimeSettingsPanel()
				@aboutSettingsPanel()
				<p class="k-help k-settings-empty" id="settings-empty" role="status" hidden>No settings match.</p>
			</form>
		</div>
	</section>
}

// agentSettingsPanel is Settings · Agent (§5.9). The provider cards and the
// current values are filled by js/ui/agentsettings.js from GET
// /api/agent/settings; every change is saved as it is made. No control here
// holds a key: a key goes to PUT /api/agent/keys/{provider} and is emptied
// from the field once saved.
templ agentSettingsPanel() {
	<div class="settings-panel" id="agent-settings" data-settings-panel="agent" role="tabpanel" hidden>
		<h1 class="k-page-title">Agent</h1>
		<p class="k-muted k-settings-lead">The agent reads only the panes you allow and suggests commands. It never types into a pane on its own.</p>
		@settingsGroup("Provider") {
			<div class="pref-row pref-row-preview">
				<div class="k-agent-cards" id="agent-set-providers" aria-live="polite"></div>
			</div>
			<div class="pref-row" id="agent-set-model-row">
				<div class="pref-copy">
					<div class="pref-title">Model</div>
					<p class="pref-desc">Used by the agent panel. Suggestions in panes use the provider's small, fast model.</p>
				</div>
				@settingsSelect("agent-set-model", "agentModel", "Model", "Model", agentDefaultModel(), agentModels(), agentModels())
			</div>
		}
		@settingsGroup("Suggestions in panes") {
			<div class="pref-row">
				<div class="pref-copy">
					<div class="pref-title">Suggest a command when I type plain language</div>
					<p class="pref-desc">Press ⇥ to see it. Nothing is inserted until you accept, and nothing runs until you press ↵.</p>
				</div>
				@agentSwitch("agent-set-suggest", "Suggest commands")
			</div>
			<div class="pref-row">
				<div class="pref-copy">
					<div class="pref-title">Suggest from this pane's scrollback</div>
					<p class="pref-desc">Offers a command already shown at the pane's prompt. Up to 40 recent commands from the pane are sent to TypeSafe Jev, redacted, each time you press ⇥.</p>
				</div>
				@agentSwitch("agent-set-history-suggest", "Suggest from this pane's scrollback")
			</div>
			<div class="pref-row pref-row-stack">
				<div class="pref-copy">
					<div class="pref-title" id="agent-set-detection-label">How to notice plain language</div>
				</div>
				<div class="k-radios" id="agent-set-detection" role="radiogroup" aria-labelledby="agent-set-detection-label">
					@agentRadio("data-agent-detection", "auto", "Notice automatically", "Needs a Jev key")
					@agentRadio("data-agent-detection", "hash-only", "Only lines starting with #", "")
				</div>
				<p class="k-help k-agent-note" id="agent-set-detection-note" hidden></p>
			</div>
		}
		@settingsGroup("Agent panel") {
			<div class="pref-row pref-row-stack">
				<div class="pref-copy">
					<div class="pref-title" id="agent-set-scope-label">Default panes per conversation</div>
					<p class="pref-desc">Which panes the agent may read when you start a conversation.</p>
				</div>
				<div class="k-radios" id="agent-set-scope" role="radiogroup" aria-labelledby="agent-set-scope-label">
					@agentRadio("data-agent-scope", "focused", "Focused pane only", "")
					@agentRadio("data-agent-scope", "pick", "Panes I pick each time", "")
					@agentRadio("data-agent-scope", "tab", "Every pane in the tab", "")
				</div>
			</div>
			<div class="pref-row">
				<div class="pref-copy">
					<div class="pref-title">Scrollback lines per pane</div>
					<p class="pref-desc">50–1000. How much of each pane the agent reads. Default 200.</p>
				</div>
				<div class="pref-slider">
					@slider.Slider(slider.Props{
						ID:           "agent-set-lines",
						Min:          50,
						Max:          1000,
						Step:         10,
						DefaultValue: []float64{200},
						Class:        "w-36",
					})
					<output id="agent-set-lines-out" aria-label="Scrollback lines">200</output>
				</div>
			</div>
		}
		@settingsGroup("Notes for the agent") {
			<div class="pref-row pref-row-stack">
				<div class="pref-copy">
					<div class="pref-title">Your notes</div>
					<p class="pref-desc">How you like to work, for every host. Sent with questions that read a pane on a host the agent may read, redacted like pane text. A host's own notes are in Edit host.</p>
				</div>
				@notesBlock("agent-set-notes", "Notes about you", "Add a note, e.g. Prefer journalctl over tail -f", "The agent may propose a note; nothing is saved until you press Save. Stored encrypted in the vault.", false)
			</div>
			<div class="pref-row">
				<div class="pref-copy">
					<div class="pref-title">Delete all notes</div>
					<p class="pref-desc">Forget every host note and every note about you. Conversations stay.</p>
				</div>
				<button type="button" class="k-btn k-btn--danger k-btn--sm" id="agent-set-delete-notes">Delete all notes</button>
			</div>
		}
		@settingsGroup("Safety") {
			<div class="pref-row">
				<div class="pref-copy">
					<div class="pref-title">The agent never types into a pane</div>
					<p class="pref-desc">Only you do, with Type, ⇥ or ⇧⇥. Nothing runs until you press ↵.</p>
				</div>
				@alwaysOn()
			</div>
			<div class="pref-row">
				<div class="pref-copy">
					<div class="pref-title">Secrets are always redacted</div>
					<p class="pref-desc">Values that look like tokens, keys and passwords are replaced before anything is sent. The vault is never sent.</p>
				</div>
				@alwaysOn()
			</div>
			<div class="pref-row">
				<div class="pref-copy">
					<div class="pref-title">Risky commands need ⇧⇥</div>
					<p class="pref-desc">Plain ⇥ never inserts a destructive command. On production hosts a command that changes state needs ⇧⇥ too. Read-only commands insert with ⇥ everywhere.</p>
				</div>
				@alwaysOn()
			</div>
			<div class="pref-row">
				<div class="pref-copy">
					<div class="pref-title">Redact IP addresses</div>
					<p class="pref-desc">Replace IPv4 and IPv6 addresses before sending.</p>
				</div>
				@agentSwitch("agent-set-ips", "Redact IP addresses")
			</div>
			<div class="pref-row">
				<div class="pref-copy">
					<div class="pref-title">Redact hostnames</div>
					<p class="pref-desc">Replace host names and domains before sending.</p>
				</div>
				@agentSwitch("agent-set-hostnames", "Redact hostnames")
			</div>
		}
		@settingsGroup("History") {
			<div class="pref-row">
				<div class="pref-copy">
					<div class="pref-title">Keep conversations</div>
					<p class="pref-desc">Saved encrypted in the vault, redacted as sent, and deleted when older than this. Only while open never writes them to disk.</p>
				</div>
				@settingsSelect("agent-set-history", "agentHistory", "Keep conversations", "Keep", "30", []string{"0", "7", "30", "90", "365"}, []string{"Only while open", "7 days", "30 days", "90 days", "1 year"})
			</div>
			<div class="pref-row">
				<div class="pref-copy">
					<div class="pref-title">Delete all history</div>
					<p class="pref-desc">Forget every conversation now. The Agent log keeps what was read.</p>
				</div>
				<button type="button" class="k-btn k-btn--danger k-btn--sm" id="agent-set-delete-history">Delete all history</button>
			</div>
		}
	</div>
}

templ agentSwitch(id, label string) {
	<button type="button" class="k-switch" role="switch" id={ id } aria-checked="false" aria-label={ label }></button>
}

// agentRadio is one choice of a radio group: a button with role radio, so a
// screen reader reads the group and the arrow keys move through it.
templ agentRadio(attr, value, label, badge string) {
	<button type="button" class="k-choice k-choice--btn" role="radio" aria-checked="false" { attr }={ value }>
		<span class="k-radio" aria-hidden="true"></span>
		<span>{ label }</span>
		if badge != "" {
			<span class="k-badge k-badge--outline">{ badge }</span>
		}
	</button>
}

templ alwaysOn() {
	<span class="k-badge k-badge--outline">
		@gateIcon("lock")
		Always on
	</span>
}

templ settingsNav(id, label string, active bool) {
	<button
		type="button"
		class={ "k-rail-item settings-nav", templ.KV("is-active", active) }
		data-settings-section={ id }
		role="tab"
		if active {
			aria-selected="true"
		} else {
			aria-selected="false"
		}
	>
		{ label }
	</button>
}

templ settingsGroup(title string) {
	<section class="settings-group">
		if title != "" {
			<h2 class="settings-group-title">{ title }</h2>
		}
		<div class="settings-group-body">
			{ children... }
		</div>
	</section>
}
