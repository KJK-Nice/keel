package ui

import (
	"keel/components/badge"
	"keel/components/button"
	"keel/components/empty"
	"keel/components/icon"
	"keel/components/item"
)

templ HostList(p PageProps) {
	<div id="host-list" class="host-list flex flex-col gap-2">
		if p.Locked {
			@emptyBox("", "Vault locked", "Unlock the vault to see hosts.")
		} else {
			{{ groups := groupHosts(p.Hosts, p.Query) }}
			if len(groups) == 0 {
				@empty.Empty() {
					@empty.Header() {
						@empty.Media(empty.MediaProps{Variant: empty.MediaVariantIcon}) {
							@icon.Server()
						}
						@empty.Title() {
							No hosts match
						}
						@empty.Description() {
							Add a server or clear the search.
						}
					}
				}
			} else {
				for _, g := range groups {
					<h2 class="group-label">{ g.Name }</h2>
					@item.Group() {
						for _, h := range g.Hosts {
							@item.Item(item.Props{
								Size:       item.SizeSm,
								Class:      "host",
								Attributes: templ.Attributes{"data-id": h.ID},
							}) {
								@item.Media() {
									<span class="dot" style={ "--dot:" + h.Color + ";background:" + h.Color }></span>
								}
								@item.Content(item.ContentProps{Attributes: templ.Attributes{"role": "button", "tabindex": "0", "data-connect": h.ID}}) {
									@item.Title() {
										{ h.Name }
									}
									@item.Description() {
										{ hostSubtitle(h) }
									}
								}
								@item.Actions() {
									if h.AuthType == "local" {
										@rowMenu("data-edit", h.ID, "", "")
									} else {
										@rowMenu("data-edit", h.ID, "data-delete", h.ID)
									}
								}
							}
						}
					}
				}
			}
		}
	</div>
}

templ IdentityList(p PageProps) {
	<div id="identity-list" class="host-list flex flex-col gap-2">
		if len(p.Identities) == 0 {
			@empty.Empty() {
				@empty.Header() {
					@empty.Media(empty.MediaProps{Variant: empty.MediaVariantIcon}) {
						@icon.KeyRound()
					}
					@empty.Title() {
						No identities yet
					}
					@empty.Description() {
						Add a password or key and attach it to hosts.
					}
				}
			}
		} else {
			@item.Group() {
				for _, id := range p.Identities {
					@item.Item(item.Props{Size: item.SizeSm, Class: "host"}) {
						@item.Media() {
							<span class="dot" style="background:var(--keel-accent)"></span>
						}
						@item.Content(item.ContentProps{Attributes: templ.Attributes{"role": "button", "tabindex": "0", "data-edit-identity": id.ID}}) {
							@item.Title() {
								{ id.Name }
							}
							@item.Description() {
								{ id.Kind }
								if id.Username != "" {
									{ " · " + id.Username }
								}
							}
						}
						@item.Actions() {
							@rowMenu("data-edit-identity", id.ID, "data-delete-identity", id.ID)
						}
					}
				}
			}
		}
	</div>
}

templ TunnelList(p PageProps) {
	<div id="tunnel-list" class="host-list flex flex-col gap-2">
		if len(p.Tunnels) == 0 {
			@empty.Empty() {
				@empty.Header() {
					@empty.Media(empty.MediaProps{Variant: empty.MediaVariantIcon}) {
						@icon.ArrowLeftRight()
					}
					@empty.Title() {
						No forwards yet
					}
					@empty.Description() {
						Local (−L), remote (−R), or dynamic SOCKS5 (−D).
					}
				}
			}
		} else {
			@item.Group() {
				for _, t := range p.Tunnels {
					@item.Item(item.Props{Size: item.SizeSm, Class: "host"}) {
						@item.Media() {
							<span class="dot"></span>
						}
						@item.Content() {
							@item.Title() {
								{ t.Name }
							}
							@item.Description() {
								{ t.Kind } · { hostNameByID(p.Hosts, t.HostID) } · { tunnelListen(t) } → { tunnelDest(t) }
								if t.Error != "" {
									{ " · " + t.Error }
								}
							}
						}
						@item.Actions(item.ActionsProps{Class: "host-tools"}) {
							@badge.Badge(badge.Props{Variant: tunnelBadgeVariant(t.Status)}) {
								if string(t.Status) == "" {
									stopped
								} else {
									{ string(t.Status) }
								}
							}
							@button.Button(button.Props{
								Variant:    button.VariantGhost,
								Size:       button.SizeXs,
								Class:      "tiny",
								Attributes: templ.Attributes{"data-tunnel-start": t.ID},
							}) {
								Start
							}
							@button.Button(button.Props{
								Variant:    button.VariantGhost,
								Size:       button.SizeXs,
								Class:      "tiny",
								Attributes: templ.Attributes{"data-tunnel-stop": t.ID},
							}) {
								Stop
							}
							@rowMenu("data-edit-tunnel", t.ID, "data-delete-tunnel", t.ID)
						}
					}
				}
			}
		}
	</div>
}

templ SnippetList(p PageProps) {
	<div id="snippet-list" class="snippet-list flex flex-col gap-2">
		if len(p.Snippets) == 0 {
			@empty.Empty() {
				@empty.Header() {
					@empty.Media(empty.MediaProps{Variant: empty.MediaVariantIcon}) {
						@icon.CodeXml()
					}
					@empty.Title() {
						No snippets yet
					}
					@empty.Description() {
						Save commands you type all the time. Click one to send it into the focused pane.
					}
				}
			}
		} else {
			@item.Group() {
				for _, s := range p.Snippets {
					@item.Item(item.Props{Size: item.SizeSm, Class: "snippet-row"}) {
						@item.Content(item.ContentProps{Attributes: templ.Attributes{"role": "button", "tabindex": "0", "data-run": s.ID}}) {
							@item.Title() {
								{ s.Name }
							}
							@item.Description() {
								{ s.Command }
							}
						}
						@item.Actions() {
							@rowMenu("data-edit-snippet", s.ID, "data-delete-snippet", s.ID)
						}
					}
				}
			}
		}
	</div>
}

templ LogList(p PageProps) {
	<div id="log-list" class="log-list">
		{{ rows := filterLogs(p.Logs, p.LogFilter) }}
		if len(rows) == 0 {
			@emptyBox("", "No log entries", "Connection and vault events show up here.")
		} else {
			for _, e := range rows {
				<div class="log-row">
					<time>{ e.Time.UTC().Format("2006-01-02 15:04:05") }</time>
					@badge.Badge(badge.Props{Variant: logBadgeVariant(e.Kind), Class: "kind"}) {
						{ e.Kind }
					}
					<span>{ e.Message }</span>
				</div>
			}
		}
	</div>
}
