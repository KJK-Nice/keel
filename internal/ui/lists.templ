package ui

import (
	"keel/components/badge"
	"keel/components/button"
	"keel/components/card"
	"keel/components/empty"
	"keel/components/icon"
	"keel/components/item"
	"keel/internal/store"
)

templ HostList(p PageProps) {
	<div id="host-list" class="host-list flex flex-col gap-6">
		if p.Locked {
			@emptyBox("", "Vault locked", "Unlock the vault to see hosts.")
		} else {
			{{ groups := groupHosts(p.Hosts, p.Query) }}
			{{ folders := folderGroups(groups) }}
			{{ hosts := flatHosts(groups) }}
			if len(hosts) == 0 {
				@empty.Empty() {
					@empty.Header() {
						@empty.Media(empty.MediaProps{Variant: empty.MediaVariantIcon}) {
							@icon.Server()
						}
						@empty.Title() {
							No hosts match
						}
						@empty.Description() {
							Add a server or clear the search.
						}
					}
				}
			} else {
				if len(folders) > 0 {
					<section class="flex flex-col gap-2">
						@sectionHeading("Groups")
						<div class="grid grid-cols-1 gap-2 sm:grid-cols-2 xl:grid-cols-3">
							for _, g := range folders {
								@groupCard(g)
							}
						</div>
					</section>
				}
				<section class="flex flex-col gap-2">
					@sectionHeading("Hosts")
					<div class="grid grid-cols-1 gap-2 sm:grid-cols-2 xl:grid-cols-3">
						for _, h := range hosts {
							@hostCard(h)
						}
					</div>
				</section>
			}
		}
	</div>
}

templ sectionHeading(title string) {
	<h2 class="text-muted-foreground text-xs font-medium tracking-wider uppercase">{ title }</h2>
}

templ hostGlyph(color, kind string) {
	if kind == "folder" {
		<span class="bg-primary/15 text-primary flex size-9 shrink-0 items-center justify-center rounded-lg [&_svg]:size-4">
			@icon.Folder01()
		</span>
	} else {
		<span
			class="flex size-9 shrink-0 items-center justify-center rounded-lg [&_svg]:size-4"
			style={ "--host-color:" + color + ";background:color-mix(in srgb, var(--host-color) 22%, transparent);color:var(--host-color)" }
		>
			if kind == "local" {
				@icon.ComputerTerminal01()
			} else {
				@icon.ServerStack01()
			}
		</span>
	}
}

templ groupCard(g hostGroup) {
	@card.Card(card.Props{
		Size:  card.SizeSm,
		Class: "host-tile cursor-pointer py-0 hover:bg-muted/50",
		Attributes: templ.Attributes{
			"data-group-filter": g.Name,
			"role":              "button",
			"tabindex":          "0",
		},
	}) {
		@card.Content(card.ContentProps{Class: "flex flex-row items-center gap-3 py-3"}) {
			@hostGlyph("", "folder")
			<div class="min-w-0 flex-1">
				@card.Title() {
					{ g.Name }
				}
				@card.Description() {
					{ hostCountLabel(len(g.Hosts)) }
				}
			</div>
		}
	}
}

templ hostCard(h store.Host) {
	@card.Card(card.Props{
		Size:       card.SizeSm,
		Class:      "host-tile py-0 hover:bg-muted/50",
		Attributes: templ.Attributes{"data-id": h.ID},
	}) {
		@card.Content(card.ContentProps{Class: "flex flex-row items-center gap-3 py-3"}) {
			@hostGlyph(h.Color, hostProtocol(h))
			<div
				class="min-w-0 flex-1 cursor-pointer"
				role="button"
				tabindex="0"
				data-connect={ h.ID }
			>
				@card.Title() {
					{ h.Name }
				}
				@card.Description(card.DescriptionProps{Class: "flex flex-wrap items-center gap-1"}) {
					@badge.Badge(badge.Props{Variant: badge.VariantOutline}) {
						{ hostProtocol(h) }
					}
					if h.Group != "" && h.Group != "Hosts" {
						@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
							{ h.Group }
						}
					}
					<span class="truncate">{ hostSubtitle(h) }</span>
				}
			</div>
			<div class="opacity-0 group-hover/card:opacity-100 focus-within:opacity-100">
				if h.AuthType == "local" {
					@rowMenu("data-edit", h.ID, "", "")
				} else {
					@rowMenu("data-edit", h.ID, "data-delete", h.ID)
				}
			</div>
		}
	}
}

templ IdentityList(p PageProps) {
	<div id="identity-list" class="host-list flex flex-col gap-2">
		if len(p.Identities) == 0 {
			@empty.Empty() {
				@empty.Header() {
					@empty.Media(empty.MediaProps{Variant: empty.MediaVariantIcon}) {
						@icon.KeyRound()
					}
					@empty.Title() {
						No identities yet
					}
					@empty.Description() {
						Add a password or key and attach it to hosts.
					}
				}
			}
		} else {
			@item.Group() {
				for _, id := range p.Identities {
					@item.Item(item.Props{Size: item.SizeSm, Class: "host"}) {
						@item.Media() {
							<span class="dot" style="background:var(--keel-accent)"></span>
						}
						@item.Content(item.ContentProps{Attributes: templ.Attributes{"role": "button", "tabindex": "0", "data-edit-identity": id.ID}}) {
							@item.Title() {
								{ id.Name }
							}
							@item.Description() {
								{ id.Kind }
								if id.Username != "" {
									{ " · " + id.Username }
								}
							}
						}
						@item.Actions() {
							@rowMenu("data-edit-identity", id.ID, "data-delete-identity", id.ID)
						}
					}
				}
			}
		}
	</div>
}

templ TunnelList(p PageProps) {
	<div id="tunnel-list" class="host-list flex flex-col gap-2">
		if len(p.Tunnels) == 0 {
			@empty.Empty() {
				@empty.Header() {
					@empty.Media(empty.MediaProps{Variant: empty.MediaVariantIcon}) {
						@icon.ArrowLeftRight()
					}
					@empty.Title() {
						No forwards yet
					}
					@empty.Description() {
						Local (−L), remote (−R), or dynamic SOCKS5 (−D).
					}
				}
			}
		} else {
			@item.Group() {
				for _, t := range p.Tunnels {
					@item.Item(item.Props{Size: item.SizeSm, Class: "host"}) {
						@item.Media() {
							<span class="dot"></span>
						}
						@item.Content() {
							@item.Title() {
								{ t.Name }
							}
							@item.Description() {
								{ t.Kind } · { hostNameByID(p.Hosts, t.HostID) } · { tunnelListen(t) } → { tunnelDest(t) }
								if t.Error != "" {
									{ " · " + t.Error }
								}
							}
						}
						@item.Actions(item.ActionsProps{Class: "host-tools"}) {
							@badge.Badge(badge.Props{Variant: tunnelBadgeVariant(t.Status)}) {
								if string(t.Status) == "" {
									stopped
								} else {
									{ string(t.Status) }
								}
							}
							@button.Button(button.Props{
								Variant:    button.VariantGhost,
								Size:       button.SizeXs,
								Class:      "tiny",
								Attributes: templ.Attributes{"data-tunnel-start": t.ID},
							}) {
								Start
							}
							@button.Button(button.Props{
								Variant:    button.VariantGhost,
								Size:       button.SizeXs,
								Class:      "tiny",
								Attributes: templ.Attributes{"data-tunnel-stop": t.ID},
							}) {
								Stop
							}
							@rowMenu("data-edit-tunnel", t.ID, "data-delete-tunnel", t.ID)
						}
					}
				}
			}
		}
	</div>
}

templ SnippetList(p PageProps) {
	<div id="snippet-list" class="snippet-list flex flex-col gap-2">
		if len(p.Snippets) == 0 {
			@empty.Empty() {
				@empty.Header() {
					@empty.Media(empty.MediaProps{Variant: empty.MediaVariantIcon}) {
						@icon.CodeXml()
					}
					@empty.Title() {
						No snippets yet
					}
					@empty.Description() {
						Save commands you type all the time. Click one to send it into the focused pane.
					}
				}
			}
		} else {
			@item.Group() {
				for _, s := range p.Snippets {
					@item.Item(item.Props{Size: item.SizeSm, Class: "snippet-row"}) {
						@item.Content(item.ContentProps{Attributes: templ.Attributes{"role": "button", "tabindex": "0", "data-run": s.ID}}) {
							@item.Title() {
								{ s.Name }
							}
							@item.Description() {
								{ s.Command }
							}
						}
						@item.Actions() {
							@rowMenu("data-edit-snippet", s.ID, "data-delete-snippet", s.ID)
						}
					}
				}
			}
		}
	</div>
}

templ LogList(p PageProps) {
	<div id="log-list" class="log-list">
		{{ rows := filterLogs(p.Logs, p.LogFilter) }}
		if len(rows) == 0 {
			@emptyBox("", "No log entries", "Connection and vault events show up here.")
		} else {
			for _, e := range rows {
				<div class="log-row">
					<time>{ e.Time.UTC().Format("2006-01-02 15:04:05") }</time>
					@badge.Badge(badge.Props{Variant: logBadgeVariant(e.Kind), Class: "kind"}) {
						{ e.Kind }
					}
					<span>{ e.Message }</span>
				</div>
			}
		}
	</div>
}
