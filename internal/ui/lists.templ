package ui

import (
	"keel/components/dropdownmenu"
	"keel/components/icon"
	"keel/internal/applog"
	"keel/internal/store"
	"keel/internal/tunnel"
)

// HostList is the Vault sidebar's host tree: hosts outside any group
// first, then each group (folder) with its hosts and subgroups. term.js
// repaints it from /ui/hosts and keeps the data-* hooks (connect, menus,
// drag into a group, collapse).
templ HostList(p PageProps) {
	<div
		id="host-list"
		class="k-tree"
		data-max-group-depth={ nestDepthAttr(store.MaxGroupDepth) }
		data-group-drop=""
		if p.Query != "" {
			data-filtering
		}
	>
		if p.Locked {
			@sideEmpty("Vault locked", "Unlock the vault to see hosts.")
		} else {
			{{ tree := nestGroupTree(p.Groups, p.Hosts, p.Query, "") }}
			{{ loose := ungroupedHosts(p.Hosts, p.Groups, p.Query) }}
			if vaultTreeEmpty(tree, loose) {
				@sideEmpty("No hosts match", "Add a host or clear the filter.")
			} else {
				for _, h := range loose {
					@treeHost(h)
				}
				for _, n := range tree {
					@treeGroup(n)
				}
			}
		}
	</div>
}

templ sideEmpty(title, desc string) {
	<div class="k-side-empty" data-slot="empty">
		<p class="k-side-empty-title">{ title }</p>
		<p class="k-help">{ desc }</p>
	</div>
}

templ treeGroup(n groupNode) {
	<div
		class="group-tree-node k-tree-group"
		data-group-id={ n.Group.ID }
		data-group-drop={ n.Group.ID }
		data-group-parent={ n.Group.ParentID }
		data-group-depth={ nestDepthAttr(n.Depth) }
		data-group-name={ n.Group.Name }
	>
		<div class="group-tree-heading k-tree-row" draggable="true" data-drag-group={ n.Group.ID }>
			<button
				type="button"
				class="k-tree-grp"
				data-group-toggle={ n.Group.ID }
				aria-expanded="true"
			>
				@icon.ChevronDown(icon.Props{Class: "k-tree-chev"})
				<span class="k-tree-grp-name" data-group-title={ n.Group.ID }>{ n.Group.Name }</span>
				<span class="k-tree-count">{ countLabel(n.Count) }</span>
			</button>
			<div class="k-tree-menu" data-group-menu={ n.Group.ID }>
				@groupRowMenu(n)
			</div>
		</div>
		<div class="group-tree-children">
			for _, h := range n.Hosts {
				@treeHost(h)
			}
			for _, k := range n.Kids {
				@treeGroup(k)
			}
		</div>
	</div>
}

templ treeHost(h store.Host) {
	<div class="k-tree-row k-tree-hostrow" data-id={ h.ID } draggable="true" data-drag-host={ h.ID }>
		<button type="button" class="k-tree-host" data-connect={ h.ID } title={ hostSubtitle(h) }>
			@hostTile(h)
			<span class="k-tree-name">{ h.Name }</span>
			<span class="k-tree-live" data-host-live={ h.ID } hidden></span>
		</button>
		<div class="k-tree-menu">
			@hostRowMenu(h)
		</div>
	</div>
}

// hostTile is the host's 16% tint tile with its icon at full strength.
templ hostTile(h store.Host) {
	if h.Color != "" {
		<span class="k-tile k-tile--sm" style={ "--host:" + h.Color }>
			@hostIcon(h)
		</span>
	} else {
		<span class="k-tile k-tile--sm">
			@hostIcon(h)
		</span>
	}
}

templ hostIcon(h store.Host) {
	if h.AuthType == "local" {
		@icon.ComputerTerminal01()
	} else {
		@icon.Server()
	}
}

templ groupRowMenu(n groupNode) {
	@dropdownmenu.DropdownMenu() {
		<button
			type="button"
			class="k-btn k-btn--ghost k-btn--sm k-btn--icon"
			aria-label="Folder actions"
			{ dropdownmenu.Trigger(ctx)... }
		>
			@icon.MoreHorizontal()
		</button>
		@dropdownmenu.Content(dropdownmenu.ContentProps{Align: dropdownmenu.AlignEnd, Side: dropdownmenu.SideBottom, Class: "w-auto min-w-max"}) {
			@dropdownmenu.Item(dropdownmenu.ItemProps{Attributes: templ.Attributes{"data-group-open": n.Group.ID}}) {
				Roles and runbooks
			}
			@dropdownmenu.Item(dropdownmenu.ItemProps{Attributes: templ.Attributes{"data-group-edit": n.Group.ID}}) {
				Edit
			}
			@dropdownmenu.Item(dropdownmenu.ItemProps{Attributes: templ.Attributes{"data-group-new": n.Group.ID}}) {
				New subgroup
			}
			@dropdownmenu.Item(dropdownmenu.ItemProps{Attributes: templ.Attributes{"data-group-rename": n.Group.ID}}) {
				Rename
			}
			@dropdownmenu.Item(dropdownmenu.ItemProps{Attributes: templ.Attributes{"data-group-move": n.Group.ID}}) {
				Move into…
			}
			@dropdownmenu.Separator()
			@dropdownmenu.Item(dropdownmenu.ItemProps{
				Variant:    dropdownmenu.ItemVariantDestructive,
				Attributes: templ.Attributes{"data-group-delete": n.Group.ID},
			}) {
				Remove
			}
		}
	}
}

// IdentityList is the Keychain page's list column: SSH keys, then
// passwords. The detail beside it is painted by term.js from the selection.
templ IdentityList(p PageProps) {
	<div id="identity-list" class="k-split-items">
		if len(p.Identities) == 0 {
			@sideEmpty("No identities yet", "Add an SSH key or a password and attach it to hosts.")
		} else {
			{{ keys := identitiesOfKind(p.Identities, "key") }}
			{{ passwords := identitiesOfKind(p.Identities, "password") }}
			if len(keys) > 0 {
				<div class="k-split-label">SSH keys</div>
				for _, id := range keys {
					@identityItem(p.Hosts, id)
				}
			}
			if len(passwords) > 0 {
				<div class="k-split-label">Passwords</div>
				for _, id := range passwords {
					@identityItem(p.Hosts, id)
				}
			}
		}
	</div>
}

templ identityItem(hosts []store.Host, id store.Identity) {
	<button
		type="button"
		class="k-item"
		data-identity-select={ id.ID }
		data-filter-text={ id.Name + " " + id.Username }
		data-show={ filterShow("_identityFilter") }
		aria-selected="false"
	>
		<span class="k-tile">
			if id.Kind == "key" {
				@icon.Key01()
			} else {
				@icon.SquareLockPassword()
			}
		</span>
		<span class="k-item-main">
			<span class="k-item-name">{ id.Name }</span>
			<span class="k-item-sub">{ identitySubtitle(hosts, id) }</span>
		</span>
		if id.Kind == "key" && id.Passphrase != "" {
			<span class="k-badge">passphrase</span>
		} else {
			<span></span>
		}
	</button>
}

// TunnelList is the Port forwarding table body.
templ TunnelList(p PageProps) {
	<tbody id="tunnel-list">
		if len(p.Tunnels) == 0 {
			<tr class="k-table-empty">
				<td colspan="7">
					@sideEmpty("No forwards yet", "Local (-L), remote (-R) or dynamic SOCKS5 (-D), each through a saved host.")
				</td>
			</tr>
		} else {
			for _, t := range p.Tunnels {
				@tunnelRow(p.Hosts, t)
			}
		}
	</tbody>
}

templ tunnelRow(hosts []store.Host, t tunnel.Info) {
	{{ st := tunnelState(t) }}
	<tr
		data-id={ t.ID }
		data-status={ st.Filter }
		data-filter-text={ t.Name + " " + hostNameByID(hosts, t.HostID) + " " + tunnelListen(t) + " " + tunnelDest(t) }
		data-show={ "(" + filterShow("_tunnelFilter") + ") && ($_tunnelState === 'all' || el.dataset.status === $_tunnelState)" }
	>
		<td><span class="k-cell-name">{ t.Name }</span></td>
		<td><span class="k-badge k-badge--mono">{ tunnelFlag(t.Kind) }</span></td>
		<td>
			<span class="k-flow">{ tunnelListen(t) }<span class="k-flow-arrow" aria-hidden="true">→</span>{ tunnelDest(t) }</span>
			if tunnelEveryInterface(t) {
				<span class="k-badge k-badge--signal">
					@icon.Alert02()
					Every interface
				</span>
			}
		</td>
		<td><span class="k-mono k-muted">{ hostNameByID(hosts, t.HostID) }</span></td>
		<td>
			<span class={ "k-state", st.StateClass }>
				<span class={ "k-dot", st.DotClass } aria-hidden="true"></span>
				{ st.Label }
			</span>
			if t.Status == tunnel.StatusError {
				<button type="button" class="k-btn k-btn--ghost k-btn--sm" data-tunnel-start={ t.ID }>Retry</button>
			}
		</td>
		<td class="k-cell-end">
			<button
				type="button"
				class="k-switch"
				role="switch"
				aria-label={ t.Name + " on" }
				if st.On {
					aria-checked="true"
					data-tunnel-stop={ t.ID }
				} else {
					aria-checked="false"
					data-tunnel-start={ t.ID }
				}
			></button>
		</td>
		<td class="k-cell-end">
			@rowMenu("data-edit-tunnel", t.ID, "data-delete-tunnel", t.ID)
		</td>
	</tr>
}

// SnippetList is the Snippets page's list column; the editor beside it is
// filled by term.js from the selection.
templ SnippetList(p PageProps) {
	<div id="snippet-list" class="k-split-items">
		if len(p.Snippets) == 0 {
			@sideEmpty("No snippets yet", "Save commands you type often. Typing one always goes through Approve before type.")
		} else {
			for _, s := range p.Snippets {
				<button
					type="button"
					class="k-item"
					data-snippet-select={ s.ID }
					data-filter-text={ s.Name + " " + s.Command }
					data-show={ filterShow("_snippetFilter") }
					aria-selected="false"
				>
					<span class="k-tile">
						@icon.CodeXml()
					</span>
					<span class="k-item-main">
						<span class="k-item-name">{ s.Name }</span>
						<span class="k-item-sub">{ snippetFirstLine(s) }</span>
					</span>
					<span></span>
				</button>
			}
		}
	</div>
}

// NotebookList is the Notebooks page's rows, pinned first.
templ NotebookList(p PageProps) {
	<div id="notebook-list" class="k-rows">
		if len(p.Notebooks) == 0 {
			@sideEmpty("No notebooks yet", "Write markdown runbooks. Fenced sh and bash blocks fill a terminal's input; nothing is typed until you confirm.")
		} else {
			for _, nb := range vaultNotebooks(p.Notebooks) {
				<div class="k-rowitem" data-id={ nb.ID } data-filter-text={ nb.Name + " " + notebookPreview(nb) } data-show={ filterShow("_notebookFilter") }>
					<button type="button" class="k-rowitem-main" data-notebook-open={ nb.ID }>
						<span class="k-tile">
							@icon.NotebookPen()
						</span>
						<span class="k-item-main">
							<span class="k-item-name">{ nb.Name }</span>
							<span class="k-item-sub">{ notebookPreview(nb) }</span>
						</span>
					</button>
					if nb.Source == store.NotebookSourceAgent {
						<span class="k-badge k-badge--outline" title="Saved by you from a draft the agent proposed">From agent</span>
					}
					if nb.Pinned {
						<span class="k-badge">Pinned</span>
					}
					@notebookCardMenu(nb)
				</div>
			}
		}
	</div>
}

templ notebookCardMenu(nb store.Notebook) {
	@dropdownmenu.DropdownMenu() {
		<button
			type="button"
			class="k-btn k-btn--ghost k-btn--sm k-btn--icon"
			aria-label="Actions"
			{ dropdownmenu.Trigger(ctx)... }
		>
			@icon.MoreHorizontal()
		</button>
		@dropdownmenu.Content(dropdownmenu.ContentProps{Align: dropdownmenu.AlignEnd, Side: dropdownmenu.SideBottom, Class: "w-auto min-w-max"}) {
			@dropdownmenu.Item(dropdownmenu.ItemProps{Attributes: templ.Attributes{"data-notebook-open": nb.ID}}) {
				Open
			}
			@dropdownmenu.Item(dropdownmenu.ItemProps{Attributes: templ.Attributes{"data-notebook-rename": nb.ID}}) {
				Rename
			}
			@dropdownmenu.Item(dropdownmenu.ItemProps{Attributes: templ.Attributes{"data-notebook-pin": nb.ID}}) {
				if nb.Pinned {
					Unpin
				} else {
					Pin
				}
			}
			@dropdownmenu.Separator()
			@dropdownmenu.Item(dropdownmenu.ItemProps{
				Variant:    dropdownmenu.ItemVariantDestructive,
				Attributes: templ.Attributes{"data-delete-notebook": nb.ID},
			}) {
				Remove
			}
		}
	}
}

// LogList is the Logs table body: newest first, filtered by the search
// box on the server and by the kind chips in term.js.
templ LogList(p PageProps) {
	<tbody id="log-list">
		{{ rows := filterLogs(p.Logs, p.LogFilter) }}
		if len(rows) == 0 {
			<tr class="k-table-empty">
				<td colspan="4">
					@sideEmpty("No log entries", "Sessions, forwards and vault changes show up here.")
				</td>
			</tr>
		} else {
			for _, e := range rows {
				@logRow(p, e)
			}
		}
	</tbody>
}

templ logRow(p PageProps, e applog.Entry) {
	<tr data-log-kind={ logGroup(e.Kind) } data-show="$_logKind === 'all' || el.dataset.logKind === $_logKind">
		<td><span class="k-mono k-muted" title={ logDateLabel(e.Time) }>{ logTimeLabel(e.Time) }</span></td>
		<td><span class={ "k-badge", logBadgeClass(e.Kind) }>{ e.Kind }</span></td>
		<td><span class="k-mono k-muted">{ logTarget(p, e) }</span></td>
		<td class="k-cell-wide">
			<span class="k-cell-msg">{ e.Message }</span>
			if facts := logFacts(e); len(facts) > 0 {
				<span class="k-log-facts" title={ logFactsTitle(e) }>
					for _, f := range facts {
						<span class="k-badge k-badge--outline">{ f }</span>
					}
				</span>
			}
		</td>
	</tr>
}
