package ui

import (
	"keel/components/badge"
	"keel/components/button"
	"keel/components/card"
	"keel/components/dropdownmenu"
	"keel/components/empty"
	"keel/components/icon"
	"keel/internal/applog"
	"keel/internal/store"
	"keel/internal/tunnel"
)

templ HostList(p PageProps) {
	<div id="host-list" class="host-list flex flex-col gap-6">
		if p.Locked {
			@emptyBox("", "Vault locked", "Unlock the vault to see hosts.")
		} else {
			{{ groups := groupHosts(p.Hosts, p.Query) }}
			{{ folders := folderGroups(groups) }}
			{{ hosts := flatHosts(groups) }}
			if len(hosts) == 0 {
				@empty.Empty() {
					@empty.Header() {
						@empty.Media(empty.MediaProps{Variant: empty.MediaVariantIcon}) {
							@icon.Server()
						}
						@empty.Title() {
							No hosts match
						}
						@empty.Description() {
							Add a server or clear the search.
						}
					}
				}
			} else {
				if len(folders) > 0 {
					<section class="flex flex-col gap-2">
						@sectionHeading("Groups")
						@tileGrid() {
							for _, g := range folders {
								@groupCard(g)
							}
						}
					</section>
				}
				<section class="flex flex-col gap-2">
					@sectionHeading("Hosts")
					@tileGrid() {
						for _, h := range hosts {
							@hostCard(h)
						}
					}
				</section>
			}
		}
	</div>
}

templ sectionHeading(title string) {
	<h2 class="text-muted-foreground text-xs font-medium tracking-wider uppercase">{ title }</h2>
}

templ tileGrid() {
	<div class="tile-grid">
		{ children... }
	</div>
}

templ tileGlyph(color, kind string) {
	if kind == "folder" {
		<span class="bg-primary/15 text-primary flex size-9 shrink-0 items-center justify-center rounded-lg [&_svg]:size-4">
			@icon.Folder01()
		</span>
	} else if kind == "L" || kind == "R" || kind == "D" {
		<span
			class="flex size-9 shrink-0 items-center justify-center rounded-lg text-xs font-semibold"
			style={ "--host-color:" + color + ";background:color-mix(in srgb, var(--host-color) 22%, transparent);color:var(--host-color)" }
		>
			{ kind }
		</span>
	} else {
		<span
			class="flex size-9 shrink-0 items-center justify-center rounded-lg [&_svg]:size-4"
			style={ "--host-color:" + color + ";background:color-mix(in srgb, var(--host-color) 22%, transparent);color:var(--host-color)" }
		>
			if kind == "local" {
				@icon.ComputerTerminal01()
			} else if kind == "password" {
				@icon.IdCard()
			} else if kind == "key" {
				@icon.Key01()
			} else if kind == "snippet" {
				@icon.CodeXml()
			} else if kind == "notebook" {
				@icon.NotepadText()
			} else if kind == "log" {
				@icon.ScrollText()
			} else {
				@icon.ServerStack01()
			}
		</span>
	}
}

templ groupCard(g hostGroup) {
	@card.Card(card.Props{
		Size:  card.SizeSm,
		Class: "host-tile cursor-pointer py-0 hover:bg-muted/50",
		Attributes: templ.Attributes{
			"data-group-filter": g.Name,
			"role":              "button",
			"tabindex":          "0",
		},
	}) {
		@card.Content(card.ContentProps{Class: "flex flex-row items-center gap-3 py-3"}) {
			@tileGlyph("", "folder")
			<div class="min-w-0 flex-1">
				@card.Title() {
					{ g.Name }
				}
				@card.Description() {
					{ hostCountLabel(len(g.Hosts)) }
				}
			</div>
		}
	}
}

templ hostCard(h store.Host) {
	@card.Card(card.Props{
		Size:       card.SizeSm,
		Class:      "host-tile py-0 hover:bg-muted/50",
		Attributes: templ.Attributes{"data-id": h.ID},
	}) {
		@card.Content(card.ContentProps{Class: "flex flex-row items-center gap-3 py-3"}) {
			@tileGlyph(h.Color, hostProtocol(h))
			<div
				class="min-w-0 flex-1 cursor-pointer"
				role="button"
				tabindex="0"
				data-connect={ h.ID }
			>
				@card.Title() {
					{ h.Name }
				}
				@card.Description(card.DescriptionProps{Class: "flex flex-wrap items-center gap-1"}) {
					@badge.Badge(badge.Props{Variant: badge.VariantOutline}) {
						{ hostProtocol(h) }
					}
					if h.Group != "" && h.Group != "Hosts" {
						@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
							{ h.Group }
						}
					}
					for _, tag := range h.Tags {
						@badge.Badge(badge.Props{
							Variant: badge.VariantOutline,
							Attributes: templ.Attributes{
								"data-tag-filter": tag,
								"role":            "button",
								"tabindex":        "0",
								"title":           "Filter by " + tag,
							},
						}) {
							{ tag }
						}
					}
					<span class="truncate">{ hostSubtitle(h) }</span>
				}
			</div>
			<div class="opacity-0 group-hover/card:opacity-100 focus-within:opacity-100">
				@hostRowMenu(h)
			</div>
		}
	}
}

templ IdentityList(p PageProps) {
	<div id="identity-list" class="host-list flex flex-col gap-6">
		if len(p.Identities) == 0 {
			@empty.Empty() {
				@empty.Header() {
					@empty.Media(empty.MediaProps{Variant: empty.MediaVariantIcon}) {
						@icon.KeyRound()
					}
					@empty.Title() {
						No identities yet
					}
					@empty.Description() {
						Add a password or key and attach it to hosts.
					}
				}
			}
		} else {
			<section class="flex flex-col gap-2">
				@sectionHeading("Identities")
				@tileGrid() {
					for _, id := range p.Identities {
						@identityCard(id)
					}
				}
			</section>
		}
	</div>
}

templ identityCard(id store.Identity) {
	@card.Card(card.Props{
		Size:       card.SizeSm,
		Class:      "host-tile py-0 hover:bg-muted/50",
		Attributes: templ.Attributes{"data-id": id.ID},
	}) {
		@card.Content(card.ContentProps{Class: "flex flex-row items-center gap-3 py-3"}) {
			@tileGlyph(identityColor(id.Kind), id.Kind)
			<div
				class="min-w-0 flex-1 cursor-pointer"
				role="button"
				tabindex="0"
				data-edit-identity={ id.ID }
			>
				@card.Title(card.TitleProps{Class: "truncate"}) {
					{ id.Name }
				}
				@card.Description(card.DescriptionProps{Class: "flex flex-wrap items-center gap-1"}) {
					@badge.Badge(badge.Props{Variant: badge.VariantOutline}) {
						{ identityKindLabel(id.Kind) }
					}
					if id.Username != "" {
						<span class="truncate">{ id.Username }</span>
					}
				}
			</div>
			<div class="opacity-0 group-hover/card:opacity-100 focus-within:opacity-100">
				@rowMenu("data-edit-identity", id.ID, "data-delete-identity", id.ID)
			</div>
		}
	}
}

templ TunnelList(p PageProps) {
	<div id="tunnel-list" class="host-list flex flex-col gap-6">
		if len(p.Tunnels) == 0 {
			@empty.Empty() {
				@empty.Header() {
					@empty.Media(empty.MediaProps{Variant: empty.MediaVariantIcon}) {
						@icon.ArrowLeftRight()
					}
					@empty.Title() {
						No forwards yet
					}
					@empty.Description() {
						Local (−L), remote (−R), or dynamic SOCKS5 (−D).
					}
				}
			}
		} else {
			<section class="flex flex-col gap-2">
				@sectionHeading("Port forwarding")
				@tileGrid() {
					for _, t := range p.Tunnels {
						@tunnelCard(p.Hosts, t)
					}
				}
			</section>
		}
	</div>
}

templ tunnelCard(hosts []store.Host, t tunnel.Info) {
	@card.Card(card.Props{
		Size:       card.SizeSm,
		Class:      "host-tile py-0 hover:bg-muted/50",
		Attributes: templ.Attributes{"data-id": t.ID},
	}) {
		@card.Content(card.ContentProps{Class: "flex flex-row items-center gap-3 py-3"}) {
			@tileGlyph(tunnelColor(t.Status), tunnelKindLetter(t.Kind))
			<div class="min-w-0 flex-1">
				@card.Title(card.TitleProps{Class: "truncate"}) {
					{ t.Name }
				}
				@card.Description(card.DescriptionProps{Class: "flex flex-wrap items-center gap-1"}) {
					@badge.Badge(badge.Props{Variant: badge.VariantOutline}) {
						{ tunnelKindLabel(t.Kind) }
					}
					@badge.Badge(badge.Props{Variant: tunnelBadgeVariant(t.Status)}) {
						if string(t.Status) == "" {
							stopped
						} else {
							{ string(t.Status) }
						}
					}
					<span class="truncate">{ hostNameByID(hosts, t.HostID) } · { tunnelListen(t) } → { tunnelDest(t) }</span>
					if t.Error != "" {
						<span class="text-destructive truncate">{ t.Error }</span>
					}
				}
			</div>
			<div class="flex items-center gap-1">
				@button.Button(button.Props{
					Variant:    button.VariantGhost,
					Size:       button.SizeXs,
					Class:      "tiny",
					Attributes: templ.Attributes{"data-tunnel-start": t.ID},
				}) {
					Start
				}
				@button.Button(button.Props{
					Variant:    button.VariantGhost,
					Size:       button.SizeXs,
					Class:      "tiny",
					Attributes: templ.Attributes{"data-tunnel-stop": t.ID},
				}) {
					Stop
				}
				<div class="opacity-0 group-hover/card:opacity-100 focus-within:opacity-100">
					@rowMenu("data-edit-tunnel", t.ID, "data-delete-tunnel", t.ID)
				</div>
			</div>
		}
	}
}

templ SnippetList(p PageProps) {
	<div id="snippet-list" class="snippet-list flex flex-col gap-6">
		if len(p.Snippets) == 0 {
			@empty.Empty() {
				@empty.Header() {
					@empty.Media(empty.MediaProps{Variant: empty.MediaVariantIcon}) {
						@icon.CodeXml()
					}
					@empty.Title() {
						No snippets yet
					}
					@empty.Description() {
						Save commands you type all the time. Click one to send it into the focused pane.
					}
				}
			}
		} else {
			<section class="flex flex-col gap-2">
				@sectionHeading("Snippets")
				@tileGrid() {
					for _, s := range p.Snippets {
						@snippetCard(s)
					}
				}
			</section>
		}
	</div>
}

templ snippetCard(s store.Snippet) {
	@card.Card(card.Props{
		Size:       card.SizeSm,
		Class:      "host-tile py-0 hover:bg-muted/50",
		Attributes: templ.Attributes{"data-id": s.ID},
	}) {
		@card.Content(card.ContentProps{Class: "flex flex-row items-center gap-3 py-3"}) {
			@tileGlyph("#6ea8ff", "snippet")
			<div
				class="min-w-0 flex-1 cursor-pointer"
				role="button"
				tabindex="0"
				data-run={ s.ID }
			>
				@card.Title(card.TitleProps{Class: "truncate"}) {
					{ s.Name }
				}
				@card.Description(card.DescriptionProps{Class: "snippet-cmd truncate"}) {
					{ snippetCommand(s) }
				}
			</div>
			<div class="opacity-0 group-hover/card:opacity-100 focus-within:opacity-100">
				@rowMenu("data-edit-snippet", s.ID, "data-delete-snippet", s.ID)
			</div>
		}
	}
}

templ NotebookList(p PageProps) {
	<div id="notebook-list" class="notebook-list flex flex-col gap-6">
		if len(p.Notebooks) == 0 {
			@empty.Empty() {
				@empty.Header() {
					@empty.Media(empty.MediaProps{Variant: empty.MediaVariantIcon}) {
						@icon.NotepadText()
					}
					@empty.Title() {
						No notebooks yet
					}
					@empty.Description() {
						Write markdown runbooks here. Open a notebook without a session. Fenced sh/bash blocks can fill CLI input — nothing is typed until you confirm.
					}
				}
			}
		} else {
			<section class="flex flex-col gap-2">
				@sectionHeading("Notebooks")
				@tileGrid() {
					for _, nb := range vaultNotebooks(p.Notebooks) {
						@notebookCard(nb)
					}
				}
			</section>
		}
	</div>
}

templ notebookCard(nb store.Notebook) {
	@card.Card(card.Props{
		Size:       card.SizeSm,
		Class:      "host-tile py-0 hover:bg-muted/50",
		Attributes: templ.Attributes{"data-id": nb.ID},
	}) {
		@card.Content(card.ContentProps{Class: "flex flex-row items-center gap-3 py-3"}) {
			@tileGlyph("#e8b849", "notebook")
			<div
				class="min-w-0 flex-1 cursor-pointer"
				role="button"
				tabindex="0"
				data-notebook-open={ nb.ID }
			>
				@card.Title(card.TitleProps{Class: "truncate"}) {
					{ nb.Name }
				}
				@card.Description(card.DescriptionProps{Class: "notebook-preview truncate"}) {
					if nb.Pinned {
						Pinned · { notebookPreview(nb) }
					} else {
						{ notebookPreview(nb) }
					}
				}
			</div>
			<div class="opacity-0 group-hover/card:opacity-100 focus-within:opacity-100">
				@notebookCardMenu(nb)
			</div>
		}
	}
}

templ notebookCardMenu(nb store.Notebook) {
	@dropdownmenu.DropdownMenu() {
		@button.Button(button.Props{
			Variant:    button.VariantGhost,
			Size:       button.SizeIconXs,
			Class:      "tiny",
			Attributes: mergeAttrs(dropdownmenu.Trigger(ctx), templ.Attributes{"aria-label": "Actions"}),
		}) {
			@icon.EllipsisVertical()
		}
		@dropdownmenu.Content(dropdownmenu.ContentProps{Align: dropdownmenu.AlignEnd, Side: dropdownmenu.SideBottom, Class: "w-auto min-w-max"}) {
			@dropdownmenu.Item(dropdownmenu.ItemProps{Attributes: templ.Attributes{"data-notebook-open": nb.ID}}) {
				Open
			}
			@dropdownmenu.Item(dropdownmenu.ItemProps{Attributes: templ.Attributes{"data-notebook-pin": nb.ID}}) {
				if nb.Pinned {
					Unpin
				} else {
					Pin
				}
			}
			@dropdownmenu.Separator()
			@dropdownmenu.Item(dropdownmenu.ItemProps{
				Variant:    dropdownmenu.ItemVariantDestructive,
				Attributes: templ.Attributes{"data-delete-notebook": nb.ID},
			}) {
				Remove
			}
		}
	}
}

templ LogList(p PageProps) {
	<div id="log-list" class="log-list flex flex-col gap-6">
		{{ rows := filterLogs(p.Logs, p.LogFilter) }}
		if len(rows) == 0 {
			@empty.Empty() {
				@empty.Header() {
					@empty.Media(empty.MediaProps{Variant: empty.MediaVariantIcon}) {
						@icon.ScrollText()
					}
					@empty.Title() {
						No log entries
					}
					@empty.Description() {
						Connection and vault events show up here.
					}
				}
			}
		} else {
			<section class="flex flex-col gap-2">
				@sectionHeading("Logs")
				<div class="flex flex-col gap-2">
					for _, e := range rows {
						@logCard(e)
					}
				</div>
			</section>
		}
	</div>
}

templ logCard(e applog.Entry) {
	@card.Card(card.Props{
		Size:  card.SizeSm,
		Class: "host-tile py-0 hover:bg-muted/50",
	}) {
		@card.Content(card.ContentProps{Class: "flex flex-row items-center gap-3 py-3"}) {
			@tileGlyph(logColor(e.Kind), "log")
			<div class="log-when">
				@card.Title() {
					{ logDateLabel(e.Time) }
				}
				@card.Description() {
					{ logTimeLabel(e.Time) }
				}
			</div>
			@badge.Badge(badge.Props{Variant: logBadgeVariant(e.Kind), Class: "kind shrink-0"}) {
				{ e.Kind }
			}
			<div class="text-muted-foreground min-w-0 flex-1 truncate text-sm">{ e.Message }</div>
		}
	}
}
